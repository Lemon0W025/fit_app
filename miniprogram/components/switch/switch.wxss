/* 弹性开关。类名都带 sw- 前缀：预览渲染器没有样式隔离。只动 transform / opacity / 颜色：
   底色两层叠着（灰底 + 绿的 sw-track 淡入），圆钮平移带回弹（cubic-bezier 冲过头一点）；按住时圆钮朝要去的那边拉长（scaleX + 偏一点） */
.sw {
  position: relative;
  flex-shrink: 0;
  width: 104rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #ddd5c8;
}

.sw-track {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 30rpx;
  background: var(--primary, #4e7d5b);
  opacity: 0;
  transition: opacity 220ms ease-out;
}

.sw-knob {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 3rpx 8rpx rgba(60, 50, 30, 0.25);
  transform: translate3d(0, 0, 0);
  transform-origin: 0 50%;
  transition: transform 340ms cubic-bezier(0.34, 1.5, 0.64, 1);
  will-change: transform;
}

.sw-on .sw-track {
  opacity: 1;
}

.sw-on .sw-knob {
  transform: translate3d(44rpx, 0, 0);
  transform-origin: 100% 50%;
}

/* 按住：朝要去的那边拉长一点 */
.sw-press .sw-knob {
  transform: translate3d(0, 0, 0) scaleX(1.18);
  transition: transform 140ms ease-out;
}

.sw-on.sw-press .sw-knob {
  transform: translate3d(44rpx, 0, 0) scaleX(1.18);
}

.sw-disabled {
  opacity: 0.45;
}
