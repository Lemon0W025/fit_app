<view class="ring {{warn ? 'ring-warn' : ''}}" style="width: {{size}}rpx; height: {{size}}rpx">
  <view class="ring-track" style="border-width: {{size * 0.12}}rpx"></view>
  <view class="ring-half ring-half-r {{leftOn ? 'ring-done' : ''}}">
    <view class="ring-arc ring-arc-r" style="border-width: {{size * 0.12}}rpx; opacity: {{rightOn ? 1 : 0}}; transform: rotate({{right}}deg)"></view>
  </view>
  <view class="ring-half ring-half-l">
    <view class="ring-arc ring-arc-l" style="border-width: {{size * 0.12}}rpx; opacity: {{leftOn ? 1 : 0}}; transform: rotate({{left}}deg)"></view>
  </view>
  <view class="ring-full" style="border-width: {{size * 0.12}}rpx; opacity: {{full ? 1 : 0}}"></view>
  <!-- 中间一块白色圆片：吃了多少 / 预算 -->
  <view class="ring-center">
    <view class="ring-disc" style="width: {{size * 0.6}}rpx; height: {{size * 0.6}}rpx">
      <text class="ring-num" style="font-size: {{size * 0.17}}rpx">{{shown}}</text>
      <view class="ring-line"></view>
      <text class="ring-unit" style="font-size: {{size * 0.075}}rpx">{{max}} 千卡</text>
    </view>
  </view>
</view>
