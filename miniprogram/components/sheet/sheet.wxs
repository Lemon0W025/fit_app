// 抽屉往下拉（components/sheet）：按住把手 / 标题栏，或者内容滚到顶以后再往下拉，面板跟着手指走。
// 跟手只在渲染层改样式（WXS），不每一帧 setData；松手拉过面板高度的 1/4、或者往下甩得够快，就叫组件的 dragClose 关掉，不然弹回。
// 只用 ES5 + Math（WXS 的写法），单元测试直接 require 这个文件

var CLOSE_RATIO = 0.25 // 拉过面板高度的这么多就关
var FLICK_SPEED = 0.5 // 像素 / 毫秒：松手前往下甩的速度到这个就算「甩」
var FLICK_MIN = 20 // 甩也至少要拉下来这么多，手一抖不算
var SLOP = 6 // 手指先动这么多，才判断是拖抽屉，还是滚内容 / 横着划
var HOLD_MS = 120 // 停住超过这么久再松手，不算甩
var FALLBACK_HEIGHT = 400 // 量不到面板高度时按这么高算
var UP_MAX = 30 // 往上拖有阻力，最多上去这么多

function shouldClose(dy, height, speed) {
  if (!(dy > 0)) return false
  if (height > 0 && dy >= height * CLOSE_RATIO) return true
  return speed >= FLICK_SPEED && dy >= FLICK_MIN
}

// 手指往下拉多少面板就下来多少；往上拉只跟一点
function follow(dy) {
  if (dy >= 0) return dy
  return -Math.min(UP_MAX, -dy / 4)
}

function point(e) {
  var t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0])
  return t ? { x: t.clientX, y: t.clientY } : null
}

function styleOf(owner, selector, css) {
  var el = owner.selectComponent(selector)
  if (el) el.setStyle(css)
}

function panelHeight(owner) {
  var el = owner.selectComponent('.sheet-move')
  var r = el && el.getBoundingClientRect ? el.getBoundingClientRect() : null
  return r && r.height > 0 ? r.height : FALLBACK_HEIGHT
}

function begin(e, owner, canDrag) {
  var st = owner.getState()
  var p = point(e)
  if (!p) return
  st.x0 = p.x
  st.y0 = p.y
  st.lastY = p.y
  st.lastT = e.timeStamp
  st.speed = 0
  st.dy = 0
  st.mode = canDrag ? 'wait' : 'none'
}

// 把手、标题栏：随时能拖
function startHead(e, owner) {
  begin(e, owner, true)
}

// 内容区：滚到顶了才能拖；正在往下滚着的不抢
function startBody(e, owner) {
  begin(e, owner, !(owner.getState().scrollTop > 0))
}

function scroll(e, owner) {
  owner.getState().scrollTop = e.detail.scrollTop
}

function move(e, owner) {
  var st = owner.getState()
  if (st.mode !== 'wait' && st.mode !== 'drag') return
  var p = point(e)
  if (!p) return
  var dx = p.x - st.x0
  var dy = p.y - st.y0
  if (st.mode === 'wait') {
    if (Math.abs(dx) < SLOP && Math.abs(dy) < SLOP) return
    // 往下、竖着比横着多：拖抽屉；别的（往上滚、横着划背包）交给内容
    if (dy > 0 && dy > Math.abs(dx)) {
      st.mode = 'drag'
      st.height = panelHeight(owner)
    } else {
      st.mode = 'none'
      return
    }
  }
  var dt = e.timeStamp - st.lastT
  if (dt > 0) st.speed = (p.y - st.lastY) / dt
  st.lastY = p.y
  st.lastT = e.timeStamp
  st.dy = dy
  var y = follow(dy)
  styleOf(owner, '.sheet-move', 'transform: translate3d(0, ' + y + 'px, 0); transition: none')
  styleOf(owner, '.sheet-dim', 'opacity: ' + (1 - Math.min(1, Math.max(0, y) / st.height) * 0.6) + '; transition: none')
  return false
}

function end(e, owner) {
  var st = owner.getState()
  var dragging = st.mode === 'drag'
  st.mode = 'none'
  if (!dragging) return
  var speed = e.timeStamp - st.lastT > HOLD_MS ? 0 : st.speed
  if (shouldClose(st.dy, st.height, speed)) {
    // 面板留在手指放开的地方，组件关的时候整块从这儿接着往下退
    owner.callMethod('dragClose')
    return false
  }
  styleOf(owner, '.sheet-move', 'transform: translate3d(0, 0, 0); transition: transform 320ms cubic-bezier(0.34, 1.4, 0.64, 1)')
  styleOf(owner, '.sheet-dim', 'opacity: 1; transition: opacity 200ms ease-out')
  return false
}

// 每次打开：上次拉下来的位置、遮罩深浅都归位（不带过渡），内容区从顶上开始
function onOpen(open, old, owner) {
  if (!owner) return
  var st = owner.getState()
  st.mode = 'none'
  st.scrollTop = 0
  if (!open) return
  styleOf(owner, '.sheet-move', 'transform: translate3d(0, 0, 0); transition: none')
  styleOf(owner, '.sheet-dim', 'opacity: 1; transition: none')
}

module.exports = {
  CLOSE_RATIO: CLOSE_RATIO,
  shouldClose: shouldClose,
  follow: follow,
  startHead: startHead,
  startBody: startBody,
  scroll: scroll,
  move: move,
  end: end,
  onOpen: onOpen,
}
