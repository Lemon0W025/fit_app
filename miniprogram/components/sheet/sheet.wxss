/* 弹性抽屉（docs/superpowers/specs/2026-10-27-ui-controls-design.md 第 1 节）。类名都带 sheet- 前缀：预览渲染器没有样式隔离。
   开：面板 420ms 弹上来、冲过头一点回弹，遮罩 280ms 淡入；关：面板 260ms 往下退（先慢后快），遮罩一起淡出。
   开关都是过渡：快速开了又关，从当前位置掉头，不跳 */
.sheet {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  pointer-events: none;
}

.sheet-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  opacity: 0;
  transition: opacity 260ms ease-in;
}

/* 往下拉时 sheet.wxs 让这层跟着变淡；开关的淡入淡出在外面那层 */
.sheet-dim {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(47, 42, 36, 0.38);
}

.sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translate3d(0, 100%, 0);
  transition: transform 260ms cubic-bezier(0.55, 0, 1, 0.45);
  will-change: transform;
}

/* 关着（和正在关）的时候不挡点击 */
.sheet-open .sheet-mask {
  opacity: 1;
  transition: opacity 280ms ease-out;
  pointer-events: auto;
}

.sheet-open .sheet-panel {
  transform: translate3d(0, 0, 0);
  transition: transform 420ms cubic-bezier(0.34, 1.4, 0.64, 1);
  pointer-events: auto;
}

/* 面板本身：往下拉时 sheet.wxs 挪的是这一层 */
.sheet-move {
  position: relative;
  background: var(--card, #fff);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(60, 50, 30, 0.12);
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 弹上来冲过头、往上拖的时候，面板底下不露出后面：往下多铺一截同色 */
.sheet-move::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  height: 240rpx;
  background: var(--card, #fff);
}

.sheet-head {
  padding: 14rpx 32rpx 12rpx;
}

/* 顶上的小把手：看得出能往下拉 */
.sheet-grip {
  width: 72rpx;
  height: 10rpx;
  margin: 0 auto 10rpx;
  border-radius: 5rpx;
  background: #ddd5c8;
}

.sheet-bar {
  display: flex;
  align-items: center;
  min-height: 72rpx;
}

.sheet-title-box {
  flex: 1;
  min-width: 0;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text, #2f2a24);
}

.sheet-close {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  line-height: 72rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--gray, #a8a095);
  transition: transform 150ms, background-color 150ms;
}

.sheet-close-press {
  transform: scale(0.9);
  background: var(--gray-soft, #f1ede6);
}

.sheet-body {
  max-height: 60vh;
}

.sheet-inner {
  padding: 4rpx 32rpx 16rpx;
}
