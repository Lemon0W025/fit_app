.cel-burst {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  pointer-events: none;
}

.cel-confetti {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}

.cel-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(47, 42, 36, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: cel-fade 0.3s ease-out backwards;
}

.cel-card {
  position: relative;
  z-index: 1;
  width: 78%;
  margin-top: 120rpx;
  padding: 0 40rpx 48rpx;
  border-radius: 32rpx;
  background: #fffdf7;
  text-align: center;
  animation: cel-card-in 0.5s cubic-bezier(0.3, 1.4, 0.5, 1) 0.1s backwards;
}

/* 纪念章一半探出卡片上沿，转半圈放大落定 */
.cel-medal {
  display: flex;
  justify-content: center;
  margin-top: -130rpx;
  animation: cel-medal-in 0.7s cubic-bezier(0.3, 1.3, 0.5, 1) 0.25s backwards;
}

.cel-title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #b8763a;
}

.cel-sub {
  font-size: 28rpx;
  color: #7a7166;
}

.cel-line {
  margin: 20rpx 0 8rpx;
  font-size: 32rpx;
  color: #2f2a24;
}

.cel-btn {
  width: 100% !important;
  margin-top: 32rpx;
  padding: 20rpx 0;
  border-radius: 48rpx;
  background: #4e7d5b;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

.cel-btn::after {
  border: none;
}

/* 营地里最亲的那只从卡片左下角探出头 */
.cel-peek {
  position: absolute;
  left: -28rpx;
  bottom: -56rpx;
  width: 150rpx;
  height: 150rpx;
  animation: cel-peek 0.5s ease-out 0.6s backwards;
}

@keyframes cel-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes cel-card-in {
  from { opacity: 0; transform: scale(0.6); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes cel-medal-in {
  from { opacity: 0; transform: scale(0.3) rotate(-180deg); }
  to { opacity: 1; transform: scale(1) rotate(0deg); }
}

@keyframes cel-peek {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}
