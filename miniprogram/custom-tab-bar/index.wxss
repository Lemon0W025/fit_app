/* 自定义底栏（docs/superpowers/specs/2026-11-07-ui-bento-design.md）。类名带 tb- 前缀：预览渲染器没有样式隔离。
   白底、上面两个大圆角；选中的 tab 图标底下一块柠檬绿圆角；中间黑色大圆钮拍照 */
.tb {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 0 12rpx env(safe-area-inset-bottom);
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(23, 25, 28, 0.06);
}

.tb-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  transition: transform 0.15s;
}

.tb-dot {
  width: 84rpx;
  height: 56rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s;
}

.tb-on .tb-dot {
  background: #c4ef5a;
}

.tb-icon {
  width: 44rpx;
  height: 44rpx;
}

.tb-text {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #8a8e95;
}

.tb-on .tb-text {
  color: #17191c;
  font-weight: 700;
}

.tb-cam-wrap {
  flex: 1;
  display: flex;
  justify-content: center;
}

.tb-cam {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #17191c;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(23, 25, 28, 0.25);
  transition: transform 0.15s;
}

.tb-cam-icon {
  width: 52rpx;
  height: 52rpx;
}

.tb-press {
  transform: scale(0.92);
}
