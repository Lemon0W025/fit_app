/* 全局样式：字号偏大、对比清晰，方便长辈使用
   配色和组件照 Starbucks 的设计系统（docs/superpowers/specs/2026-11-07-ui-starbucks-style-design.md）：
   奶油色底、白卡片；四档绿各管一件事（--brand 标题和大数字、--primary 按钮、--house 深绿横幅、--primary-soft 浅绿底）；
   金色只给暖豆、准时、纪念章这些「奖励」时刻；按钮一律胶囊、按下缩到 0.95；阴影是两三层很淡的叠起来；不用渐变 */
page {
  /* 底和卡片 */
  --bg: #f2f0eb;
  --card: #ffffff;
  --ceramic: #edebe9;

  /* 四档绿 */
  --brand: #006241;
  --primary: #00754a;
  --house: #1e3932;
  --uplift: #2b5148;
  --primary-soft: #d4e9e2;
  --primary-wash: #eaf4f0;

  /* 字：不用纯黑，跟奶油底一个温度；次要字比 Starbucks 的 58% 深一点（长辈看得清） */
  --text: rgba(0, 0, 0, 0.87);
  --muted: rgba(0, 0, 0, 0.6);
  --on-dark: #ffffff;
  --on-dark-soft: rgba(255, 255, 255, 0.78);
  --line: #e7e5e0;

  /* 奖励金：--gold 做边和底，字用 --gold-ink（金色字在白底上太浅） */
  --gold: #cba258;
  --gold-light: #dfc49d;
  --gold-wash: #faf6ee;
  --gold-ink: #85631f;

  /* 评级 */
  --green: #00754a;
  --green-soft: #d4e9e2;
  --yellow: #9a6200;
  --yellow-soft: #fdf2d8;
  --amber: #d08a1c;
  --red: #c82014;
  --red-soft: #fbe9e7;
  --gray: #a19d96;
  --gray-soft: #f2f0eb;

  /* 阴影：卡片一层发丝 + 一层贴地，浮起来的按钮再加一层环境光 */
  --shadow-card: 0 0 1rpx rgba(0, 0, 0, 0.14), 0 2rpx 2rpx rgba(0, 0, 0, 0.12), 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  --shadow-float: 0 0 12rpx rgba(0, 0, 0, 0.2), 0 16rpx 24rpx rgba(0, 0, 0, 0.14);

  background: var(--bg);
  color: var(--text);
  font-size: 32rpx;
  line-height: 1.6;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

.page {
  padding: 24rpx 32rpx 64rpx;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* 段落标题：Starbucks Green、加粗，靠颜色和粗细分层次 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand);
  margin: 48rpx 8rpx 16rpx;
}

.muted {
  color: var(--muted);
}

.small {
  font-size: 28rpx;
}

.empty {
  color: var(--muted);
  text-align: center;
  padding: 48rpx 32rpx;
}

/* 按钮：一律胶囊，按下缩到 0.95 */
button::after {
  border: none;
}

button.btn-primary {
  width: 100% !important;
  background: var(--primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 22rpx 0;
  margin: 24rpx 0;
}

button.btn-primary[disabled] {
  background: #a9cbbd !important;
  color: #fff !important;
}

button.btn-big {
  padding: 30rpx 0;
  font-size: 36rpx;
}

button.btn-plain {
  width: 100% !important;
  background: transparent;
  color: var(--primary);
  border: 3rpx solid var(--primary);
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 16rpx 0;
  margin-top: 24rpx;
}

button.btn-plain[disabled] {
  color: var(--gray) !important;
  border-color: var(--line) !important;
  background: transparent !important;
}

/* 深绿横幅上的按钮：白底绿字（主）、白边白字（次） */
button.btn-on-dark {
  background: #fff;
  color: var(--primary);
}

button.btn-on-dark[disabled] {
  background: rgba(255, 255, 255, 0.5) !important;
  color: var(--house) !important;
}

button.btn-ghost-dark {
  background: transparent;
  color: #fff;
  border-color: #fff;
}

.link {
  color: var(--primary);
  font-weight: 600;
  padding: 16rpx;
}

.link-muted {
  color: var(--muted);
}

.link-danger {
  color: var(--red);
}

/* 深绿横幅（Starbucks 的 House Green 带）：白字，次要字 78% 白 */
.band {
  background: var(--house);
  color: var(--on-dark);
}

.band .muted {
  color: var(--on-dark-soft);
}

/* 奖励卡：金色奶油底 + 金边（暖豆、新住户、纪念章） */
.reward-card {
  background: var(--gold-wash);
  box-shadow: var(--shadow-card), inset 0 0 0 2rpx var(--gold-light);
}

/* 金色胶囊：「+20 暖豆」「准时」这类奖励小标签 */
.pill-gold {
  display: inline-block;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--gold);
  color: var(--gold-ink);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

/* 选项小块 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chips-col {
  flex-direction: column;
}

/* 和商店的标签一样：按下缩到 0.95 再回来（hover-class="chip-press"），选中 / 取消时底色、字色、边框 200ms 过渡 */
.chip {
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: var(--gray-soft);
  color: var(--text);
  border: 3rpx solid transparent;
  transition: transform 0.15s, background-color 0.2s, color 0.2s, border-color 0.2s;
}

.chip-on {
  background: var(--primary-wash);
  color: var(--brand);
  border-color: var(--primary);
  font-weight: 600;
}

.chip-press {
  transform: scale(0.95);
}

/* 评级标签 */
.badge {
  font-size: 26rpx;
  font-weight: 600;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

.badge-green {
  color: var(--brand);
  background: var(--green-soft);
}

.badge-yellow {
  color: var(--yellow);
  background: var(--yellow-soft);
}

.badge-red {
  color: var(--red);
  background: var(--red-soft);
}

.badge-failed,
.badge-none {
  color: var(--muted);
  background: var(--ceramic);
}

/* 表单 */
.field {
  margin-bottom: 32rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.field-row {
  display: flex;
  gap: 24rpx;
}

.field-row .field {
  flex: 1;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: var(--gray-soft);
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-shadow: inset 0 0 0 2rpx var(--line);
}

.field-input {
  flex: 1;
  height: 92rpx;
  font-size: 34rpx;
}

.unit {
  color: var(--muted);
  font-size: 28rpx;
  margin-left: 8rpx;
}

.note {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  background: var(--gray-soft);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  box-shadow: inset 0 0 0 2rpx var(--line);
}

/* 营养素三栏 */
.macros {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.macro {
  flex: 1;
  text-align: center;
}

.macro + .macro {
  border-left: 2rpx solid var(--line);
}

.macro-num {
  font-size: 34rpx;
  font-weight: 700;
}

.macro-label {
  font-size: 26rpx;
  color: var(--muted);
}

/* 餐食通用 */
.meal-head {
  display: flex;
  align-items: center;
}

.meal-label {
  font-size: 32rpx;
  font-weight: 600;
}

.meal-time {
  font-size: 26rpx;
  color: var(--muted);
  margin-left: 12rpx;
}

.list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.list-row:last-child {
  border-bottom: none;
}

/* 文字里的暖豆小图标 */
.bean-inline {
  width: 1.2em;
  height: 1.2em;
  vertical-align: -0.25em;
  margin-right: 4rpx;
}

/* 早 / 午 / 晚打卡印章 */
.stamps {
  display: flex;
  gap: 12rpx;
  margin: 10rpx 0;
}

.stamp {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  box-sizing: border-box;
  color: #fff;
}

.stamp-green {
  background: var(--green);
}

.stamp-yellow {
  background: var(--amber);
}

.stamp-red {
  background: var(--red);
}

.stamp-done {
  background: var(--gray);
}

.stamp-none {
  border: 3rpx dashed var(--gray);
  color: var(--gray);
}

/* 准时拍的那顿：奖励金边 + 角上一个「准」（金底深绿字，Starbucks 奖励的配色） */
.stamp-on {
  position: relative;
  box-shadow: 0 0 0 5rpx var(--gold);
}

.stamp-on::after {
  content: '准';
  position: absolute;
  right: -16rpx;
  top: -16rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--gold);
  color: var(--house);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

/* 日历格子里的小印章：只要颜色 */
.stamps-small {
  gap: 4rpx;
  justify-content: center;
  margin: 4rpx 0 0;
}

.stamps-small .stamp {
  width: 20rpx;
  height: 20rpx;
  font-size: 0;
  border-width: 2rpx;
}

.stamps-small .stamp-on {
  box-shadow: 0 0 0 3rpx var(--gold);
}

.stamps-small .stamp-on::after {
  display: none;
}

/* ---------------------------------------------------------------- 打卡动效（docs/superpowers/specs/2026-10-25-checkin-effects-design.md）
   都很短、只播一次（呼吸除外）；结束的样子就是平时的样子（fill-mode 用 backwards，不挡按压效果）；
   依次出现用 fx-d1～fx-d8（每档 100ms）；页面根节点加 fx-skip 就全部跳到结束 */
@keyframes fx-rise {
  from { opacity: 0; transform: translateY(32rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fx-pop {
  0% { opacity: 0; transform: scale(0.3); }
  70% { opacity: 1; transform: scale(1.15); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes fx-stamp {
  0% { opacity: 0; transform: scale(1.6) rotate(-12deg); }
  55% { opacity: 1; transform: scale(0.92) rotate(4deg); }
  100% { opacity: 1; transform: scale(1) rotate(0deg); }
}

@keyframes fx-ink {
  0% { opacity: 0.6; transform: scale(0.8); }
  100% { opacity: 0; transform: scale(1.9); }
}

@keyframes fx-breathe {
  0%, 100% { box-shadow: var(--shadow-card), 0 0 0 0 rgba(0, 117, 74, 0); }
  50% { box-shadow: var(--shadow-card), 0 0 0 14rpx rgba(0, 117, 74, 0.22); }
}

@keyframes fx-breathe-warn {
  0%, 100% { box-shadow: var(--shadow-card), 0 0 0 0 rgba(203, 132, 40, 0); }
  50% { box-shadow: var(--shadow-card), 0 0 0 14rpx rgba(203, 132, 40, 0.32); }
}

@keyframes fx-nudge {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.035); }
}

.fx-rise { animation: fx-rise 0.45s cubic-bezier(0.2, 0.8, 0.3, 1) backwards; }
.fx-pop { animation: fx-pop 0.35s ease-out backwards; }
.fx-d1 { animation-delay: 100ms; }
.fx-d2 { animation-delay: 200ms; }
.fx-d3 { animation-delay: 300ms; }
.fx-d4 { animation-delay: 400ms; }
.fx-d5 { animation-delay: 500ms; }
.fx-d6 { animation-delay: 600ms; }
.fx-d7 { animation-delay: 700ms; }
.fx-d8 { animation-delay: 800ms; }

/* 盖章：落下、歪一下回正，周围一圈墨晕开；准时的「准」再晚一点跳出来 */
.fx-stamp {
  position: relative;
  animation: fx-stamp 0.5s cubic-bezier(0.3, 1.4, 0.5, 1) 0.15s backwards;
}

.fx-stamp::before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(203, 162, 88, 0.6);
  opacity: 0;
  animation: fx-ink 0.7s ease-out 0.35s forwards;
}

.fx-stamp.stamp-on::after {
  animation: fx-pop 0.3s ease-out 0.55s backwards;
}

/* 首页「下一顿」：饭点内慢慢呼吸，过点了琥珀色、快一点；按钮轻轻一胀一缩 */
.fx-breathe { animation: fx-breathe 4s ease-in-out infinite; }
.fx-breathe-warn { animation: fx-breathe-warn 2.5s ease-in-out infinite; }
.fx-nudge { animation: fx-nudge 2s ease-in-out infinite; }

/* 按下去缩一点，松手弹回（Starbucks 的 scale(0.95)）：按钮用自带的 button-hover，卡片、小块用 hover-class="fx-press"（选项小块 .chip 的过渡在上面） */
button,
.card {
  transition: transform 0.15s, opacity 0.15s;
}

button.button-hover {
  transform: scale(0.95);
}

.fx-press {
  transform: scale(0.97);
  opacity: 0.9;
}

/* 点一下就跳到结束 */
.fx-skip .fx-rise,
.fx-skip .fx-pop,
.fx-skip .fx-stamp,
.fx-skip .fx-stamp.stamp-on::after {
  animation: none;
}

.fx-skip .fx-stamp::before {
  display: none;
}
