/* 全局样式：字号偏大、对比清晰，方便长辈使用
   「便当盒」风格（docs/superpowers/specs/2026-11-07-ui-bento-design.md，参考 CaloriCam 一类的健康 App）：
   浅灰底、大圆角白卡片；每张卡左上一个图标小圆章 + 标题；超大加粗数字；粗胶囊进度条（碳水粉、脂肪黄、蛋白质蓝）；
   主按钮黑色胶囊、黑卡上用柠檬绿；柠檬绿只当点缀和「今天吃了多少」那张卡；暖豆、准时、纪念章用暖橙 */
page {
  /* 底、卡片、小圆章 */
  --bg: #f3f4f0;
  --card: #ffffff;
  --chip: #f1f2ee;
  --line: #ebece8;

  /* 墨黑和柠檬绿 */
  --ink: #17191c;
  --lime: #c4ef5a;
  --lime-soft: #e3f6b5;
  --lime-wash: #f3fbe0;
  --lime-deep: #8ac226;
  --lime-ink: #3f5c00;

  /* 字 */
  --text: #17191c;
  --muted: #6b6f76;
  --on-dark: #ffffff;
  --on-dark-soft: rgba(255, 255, 255, 0.7);

  /* 暖豆（奖励）和过点（提醒） */
  --bean: #f5a524;
  --bean-soft: #fff1d6;
  --bean-ink: #8a5300;
  --peach: #ffb37a;
  --peach-soft: #ffe8d6;
  --peach-ink: #a24a12;

  /* 三大营养素 */
  --carbs: #ffb8c6;
  --carbs-soft: #ffe7ec;
  --carbs-ink: #b8304f;
  --fat: #ffd86b;
  --fat-soft: #fff4cf;
  --fat-ink: #8f6200;
  --protein: #a9d3ff;
  --protein-soft: #e3f1ff;
  --protein-ink: #24609e;

  /* 评级 */
  --green: var(--lime-ink);
  --green-soft: var(--lime-soft);
  --yellow: #8f6200;
  --yellow-soft: #fff1c9;
  --amber: var(--bean);
  --red: #d93a40;
  --red-soft: #ffe4e4;
  --gray: #a3a7ad;
  --gray-soft: var(--chip);
  --ceramic: var(--chip);

  /* 旧名字（页面和组件里还在用）：都指到新的上面 */
  --primary: var(--ink);
  --brand: var(--ink);
  --house: var(--ink);
  --primary-soft: var(--lime-soft);
  --primary-wash: var(--lime-wash);
  --gold: var(--bean);
  --gold-light: #ffd48a;
  --gold-wash: var(--bean-soft);
  --gold-ink: var(--bean-ink);

  /* 阴影：很淡、往下散 */
  --shadow-card: 0 2rpx 4rpx rgba(23, 25, 28, 0.03), 0 12rpx 32rpx rgba(23, 25, 28, 0.05);
  --shadow-float: 0 4rpx 8rpx rgba(23, 25, 28, 0.08), 0 16rpx 36rpx rgba(23, 25, 28, 0.16);

  /* 数字用几何感的字（iPhone 上有，别的手机退回系统字） */
  --font-num: 'Avenir Next', 'DIN Alternate', 'Helvetica Neue', -apple-system, sans-serif;

  background: var(--bg);
  color: var(--text);
  font-size: 32rpx;
  line-height: 1.6;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

.page {
  padding: 24rpx 32rpx 64rpx;
}

/* ---------------------------------------------------------------- 卡片 */
.card {
  background: var(--card);
  border-radius: 40rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.card-lime {
  background: var(--lime-soft);
}

.card-ink,
.band {
  background: var(--ink);
  color: var(--on-dark);
}

.band .muted,
.card-ink .muted {
  color: var(--on-dark-soft);
}

.card-peach {
  background: var(--peach-soft);
}

/* 奖励卡：暖豆、新住户、日历的今天 */
.reward-card {
  background: var(--bean-soft);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

/* 卡片头：左边图标小圆章 + 标题，右边一句话或箭头 */
.card-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.chip-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--chip);
  display: flex;
  align-items: center;
  justify-content: center;
}

.chip-icon image,
.chip-icon .chip-img {
  width: 40rpx;
  height: 40rpx;
}

.card-lime .chip-icon,
.reward-card .chip-icon,
.card-peach .chip-icon {
  background: rgba(255, 255, 255, 0.7);
}

.card-ink .chip-icon,
.band .chip-icon {
  background: rgba(255, 255, 255, 0.12);
}

/* 黑卡上的图标反白 */
.card-ink .chip-icon image,
.band .chip-icon image,
.icon-white {
  filter: invert(1);
}

.card-head-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
}

.card-head-more {
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--muted);
}

.card-ink .card-head-more,
.band .card-head-more {
  color: var(--on-dark-soft);
}

.card-head-go {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-left: 8rpx;
}

/* 段落标题 */
.section-title {
  display: flex;
  align-items: baseline;
  font-size: 36rpx;
  font-weight: 800;
  margin: 48rpx 8rpx 20rpx;
}

.section-more {
  margin-left: auto;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--muted);
}

/* ---------------------------------------------------------------- 数字 */
.num {
  font-family: var(--font-num);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.05;
}

.num-unit {
  margin-left: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--muted);
  letter-spacing: 0;
}

.muted {
  color: var(--muted);
}

.small {
  font-size: 28rpx;
}

.empty {
  color: var(--muted);
  text-align: center;
  padding: 48rpx 32rpx;
}

/* ---------------------------------------------------------------- 胶囊进度条 */
.bar {
  position: relative;
  height: 24rpx;
  border-radius: 999rpx;
  background: var(--chip);
  overflow: hidden;
}

/* 宽度直接给（style="width: N%"）；第一次出来从左边滑进来 */
.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--lime);
  animation: bar-in 0.8s cubic-bezier(0.2, 0.8, 0.3, 1) 0.2s backwards;
}

@keyframes bar-in {
  from { transform: translateX(-100%); }
  to { transform: translateX(0); }
}

.bar-carbs { background: var(--carbs); }
.bar-fat { background: var(--fat); }
.bar-protein { background: var(--protein); }

/* ---------------------------------------------------------------- 按钮：一律胶囊，按下缩到 0.95 */
button::after {
  border: none;
}

button.btn-primary {
  width: 100% !important;
  background: var(--ink);
  color: #fff;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 700;
  padding: 26rpx 0;
  margin: 24rpx 0;
}

button.btn-primary[disabled] {
  background: #b9bcc1 !important;
  color: #fff !important;
}

button.btn-big {
  padding: 32rpx 0;
  font-size: 36rpx;
}

button.btn-plain {
  width: 100% !important;
  background: var(--chip);
  color: var(--ink);
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 22rpx 0;
  margin-top: 24rpx;
}

button.btn-plain[disabled] {
  color: var(--gray) !important;
  background: var(--chip) !important;
}

/* 黑卡上的主按钮：柠檬绿底黑字 */
button.btn-on-dark,
button.btn-lime {
  background: var(--lime);
  color: var(--ink);
}

button.btn-on-dark[disabled] {
  background: rgba(255, 255, 255, 0.3) !important;
  color: var(--ink) !important;
}

button.btn-peach {
  background: var(--peach);
  color: var(--ink);
}

/* 按钮里的图标 */
.btn-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  vertical-align: -10rpx;
}

/* 白色圆钮（右上角的小按钮） */
.round-btn {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--card);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.round-btn image {
  width: 44rpx;
  height: 44rpx;
}

/* 白色胶囊（「📅 10月22日 ⌄」这类） */
.pill {
  display: inline-flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--card);
  box-shadow: var(--shadow-card);
  font-size: 30rpx;
  font-weight: 600;
}

.pill image {
  width: 40rpx;
  height: 40rpx;
}

.pill image:first-child {
  margin-right: 12rpx;
}

.link {
  color: var(--ink);
  font-weight: 700;
  padding: 16rpx;
}

.link-muted {
  color: var(--muted);
}

.link-danger {
  color: var(--red);
}

/* 金色 / 暖豆小胶囊：「+20 暖豆」「准时拍能得 15 暖豆」 */
.pill-gold {
  display: inline-block;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: var(--bean-soft);
  color: var(--bean-ink);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

/* ---------------------------------------------------------------- 选项小块 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chips-col {
  flex-direction: column;
}

/* 和商店的标签一样：按下缩到 0.95 再回来（hover-class="chip-press"），选中 / 取消时底色、字色、边框 200ms 过渡；选中是黑底白字 */
.chip {
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  background: var(--chip);
  color: var(--text);
  border: 3rpx solid transparent;
  transition: transform 0.15s, background-color 0.2s, color 0.2s, border-color 0.2s;
}

.chip-on {
  background: var(--ink);
  color: #fff;
  border-color: var(--ink);
  font-weight: 700;
}

.chip-press {
  transform: scale(0.95);
}

/* 评级标签 */
.badge {
  font-size: 26rpx;
  font-weight: 700;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

.badge-green {
  color: var(--lime-ink);
  background: var(--lime-soft);
}

.badge-yellow {
  color: var(--yellow);
  background: var(--yellow-soft);
}

.badge-red {
  color: var(--red);
  background: var(--red-soft);
}

.badge-failed,
.badge-none {
  color: var(--muted);
  background: var(--chip);
}

/* ---------------------------------------------------------------- 表单 */
.field {
  margin-bottom: 32rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.field-row {
  display: flex;
  gap: 24rpx;
}

.field-row .field {
  flex: 1;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: var(--chip);
  border-radius: 28rpx;
  padding: 0 28rpx;
}

.field-input {
  flex: 1;
  height: 96rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.unit {
  color: var(--muted);
  font-size: 28rpx;
  margin-left: 8rpx;
}

.note {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  background: var(--chip);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
}

/* ---------------------------------------------------------------- 营养素三块：蛋白质蓝、碳水粉、脂肪黄 */
.macros {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.macro {
  flex: 1;
  padding: 20rpx 0 18rpx;
  border-radius: 28rpx;
  text-align: center;
  background: var(--protein-soft);
}

.macro:nth-child(2) {
  background: var(--carbs-soft);
}

.macro:nth-child(3) {
  background: var(--fat-soft);
}

.macro-num {
  font-family: var(--font-num);
  font-size: 38rpx;
  font-weight: 800;
  color: var(--protein-ink);
}

.macro:nth-child(2) .macro-num {
  color: var(--carbs-ink);
}

.macro:nth-child(3) .macro-num {
  color: var(--fat-ink);
}

.macro-label {
  font-size: 26rpx;
  color: var(--text);
}

/* ---------------------------------------------------------------- 餐食通用 */
.meal-head {
  display: flex;
  align-items: center;
}

.meal-label {
  font-size: 32rpx;
  font-weight: 700;
}

.meal-time {
  font-size: 26rpx;
  color: var(--muted);
  margin-left: 12rpx;
}

.list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.list-row:last-child {
  border-bottom: none;
}

/* 文字里的暖豆小图标 */
.bean-inline {
  width: 1.2em;
  height: 1.2em;
  vertical-align: -0.25em;
  margin-right: 4rpx;
}

/* 早 / 午 / 晚打卡印章 */
.stamps {
  display: flex;
  gap: 12rpx;
  margin: 10rpx 0;
}

.stamp {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  box-sizing: border-box;
  color: var(--ink);
}

.stamp-green {
  background: var(--lime);
}

.stamp-yellow {
  background: var(--fat);
}

.stamp-red {
  background: var(--carbs);
}

.stamp-done {
  background: var(--chip);
  color: var(--muted);
}

.stamp-none {
  border: 3rpx dashed #c9ccd0;
  color: var(--gray);
}

/* 准时拍的那顿：暖橙圈 + 角上一个「准」 */
.stamp-on {
  position: relative;
  box-shadow: 0 0 0 5rpx var(--bean);
}

.stamp-on::after {
  content: '准';
  position: absolute;
  right: -16rpx;
  top: -16rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--bean);
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

/* 日历格子里的小印章：只要颜色 */
.stamps-small {
  gap: 4rpx;
  justify-content: center;
  margin: 4rpx 0 0;
}

.stamps-small .stamp {
  width: 20rpx;
  height: 20rpx;
  font-size: 0;
  border-width: 2rpx;
}

.stamps-small .stamp-on {
  box-shadow: 0 0 0 3rpx var(--bean);
}

.stamps-small .stamp-on::after {
  display: none;
}

/* ---------------------------------------------------------------- 打卡动效（docs/superpowers/specs/2026-10-25-checkin-effects-design.md）
   都很短、只播一次（呼吸除外）；结束的样子就是平时的样子（fill-mode 用 backwards，不挡按压效果）；
   依次出现用 fx-d1～fx-d8（每档 100ms）；页面根节点加 fx-skip 就全部跳到结束 */
@keyframes fx-rise {
  from { opacity: 0; transform: translateY(32rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fx-pop {
  0% { opacity: 0; transform: scale(0.3); }
  70% { opacity: 1; transform: scale(1.15); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes fx-stamp {
  0% { opacity: 0; transform: scale(1.6) rotate(-12deg); }
  55% { opacity: 1; transform: scale(0.92) rotate(4deg); }
  100% { opacity: 1; transform: scale(1) rotate(0deg); }
}

@keyframes fx-ink {
  0% { opacity: 0.6; transform: scale(0.8); }
  100% { opacity: 0; transform: scale(1.9); }
}

@keyframes fx-breathe {
  0%, 100% { box-shadow: var(--shadow-card), 0 0 0 0 rgba(160, 214, 50, 0); }
  50% { box-shadow: var(--shadow-card), 0 0 0 16rpx rgba(160, 214, 50, 0.45); }
}

@keyframes fx-breathe-warn {
  0%, 100% { box-shadow: var(--shadow-card), 0 0 0 0 rgba(255, 150, 80, 0); }
  50% { box-shadow: var(--shadow-card), 0 0 0 16rpx rgba(255, 150, 80, 0.4); }
}

@keyframes fx-nudge {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.035); }
}

.fx-rise { animation: fx-rise 0.45s cubic-bezier(0.2, 0.8, 0.3, 1) backwards; }
.fx-pop { animation: fx-pop 0.35s ease-out backwards; }
.fx-d1 { animation-delay: 100ms; }
.fx-d2 { animation-delay: 200ms; }
.fx-d3 { animation-delay: 300ms; }
.fx-d4 { animation-delay: 400ms; }
.fx-d5 { animation-delay: 500ms; }
.fx-d6 { animation-delay: 600ms; }
.fx-d7 { animation-delay: 700ms; }
.fx-d8 { animation-delay: 800ms; }

/* 盖章：落下、歪一下回正，周围一圈墨晕开；准时的「准」再晚一点跳出来 */
.fx-stamp {
  position: relative;
  animation: fx-stamp 0.5s cubic-bezier(0.3, 1.4, 0.5, 1) 0.15s backwards;
}

.fx-stamp::before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(245, 165, 36, 0.6);
  opacity: 0;
  animation: fx-ink 0.7s ease-out 0.35s forwards;
}

.fx-stamp.stamp-on::after {
  animation: fx-pop 0.3s ease-out 0.55s backwards;
}

/* 首页「下一顿」：饭点内慢慢呼吸，过点了琥珀色、快一点；按钮轻轻一胀一缩 */
.fx-breathe { animation: fx-breathe 4s ease-in-out infinite; }
.fx-breathe-warn { animation: fx-breathe-warn 2.5s ease-in-out infinite; }
.fx-nudge { animation: fx-nudge 2s ease-in-out infinite; }

/* 按下去缩一点，松手弹回：按钮用自带的 button-hover，卡片、小块用 hover-class="fx-press"（选项小块 .chip 的过渡在上面） */
button,
.card {
  transition: transform 0.15s, opacity 0.15s;
}

button.button-hover {
  transform: scale(0.95);
}

.fx-press {
  transform: scale(0.97);
  opacity: 0.9;
}

/* 点一下就跳到结束 */
.fx-skip .fx-rise,
.fx-skip .fx-pop,
.fx-skip .fx-stamp,
.fx-skip .fx-stamp.stamp-on::after,
.fx-skip .bar-fill {
  animation: none;
}

.fx-skip .fx-stamp::before {
  display: none;
}
