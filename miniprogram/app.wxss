/* 全局样式：字号偏大、对比清晰，方便长辈使用 */
page {
  --bg: #f6f1e7;
  --card: #ffffff;
  --primary: #4e7d5b;
  --primary-soft: #e6efe7;
  --text: #2f2a24;
  --muted: #7a7166;
  --line: #ece4d6;
  --green: #4f8f5c;
  --green-soft: #e6f1e8;
  --yellow: #c98a14;
  --yellow-soft: #fbf0d9;
  --red: #d1543f;
  --red-soft: #fbe6e1;
  --gray: #a8a095;
  --gray-soft: #f1ede6;

  background: var(--bg);
  color: var(--text);
  font-size: 32rpx;
  line-height: 1.6;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

.page {
  padding: 24rpx 32rpx 64rpx;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(80, 60, 30, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--muted);
  margin: 40rpx 8rpx 16rpx;
}

.muted {
  color: var(--muted);
}

.small {
  font-size: 26rpx;
}

.empty {
  color: var(--muted);
  text-align: center;
  padding: 48rpx 32rpx;
}

/* 按钮 */
button::after {
  border: none;
}

button.btn-primary {
  width: 100% !important;
  background: var(--primary);
  color: #fff;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 20rpx 0;
  margin: 24rpx 0;
}

button.btn-primary[disabled] {
  background: #9db5a3 !important;
  color: #fff !important;
}

button.btn-big {
  padding: 28rpx 0;
  font-size: 36rpx;
}

button.btn-plain {
  width: 100% !important;
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 16rpx 0;
  margin-top: 24rpx;
}

button.btn-plain[disabled] {
  color: var(--gray) !important;
  border-color: var(--line) !important;
  background: transparent !important;
}

.link {
  color: var(--primary);
  padding: 16rpx;
}

.link-muted {
  color: var(--muted);
}

.link-danger {
  color: var(--red);
}

/* 选项小块 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chips-col {
  flex-direction: column;
}

/* 和商店的标签一样：按下缩到 0.96 再回来（hover-class="chip-press"），选中 / 取消时底色、字色、边框 200ms 过渡 */
.chip {
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  background: var(--gray-soft);
  color: var(--text);
  border: 2rpx solid transparent;
  transition: transform 0.15s, background-color 0.2s, color 0.2s, border-color 0.2s;
}

.chip-on {
  background: var(--primary-soft);
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 600;
}

.chip-press {
  transform: scale(0.96);
}

/* 评级标签 */
.badge {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.badge-green {
  color: var(--green);
  background: var(--green-soft);
}

.badge-yellow {
  color: var(--yellow);
  background: var(--yellow-soft);
}

.badge-red {
  color: var(--red);
  background: var(--red-soft);
}

.badge-failed,
.badge-none {
  color: var(--gray);
  background: var(--gray-soft);
}

/* 表单 */
.field {
  margin-bottom: 32rpx;
}

.field-label {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.field-row {
  display: flex;
  gap: 24rpx;
}

.field-row .field {
  flex: 1;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: var(--gray-soft);
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.field-input {
  flex: 1;
  height: 88rpx;
  font-size: 32rpx;
}

.unit {
  color: var(--muted);
  font-size: 28rpx;
  margin-left: 8rpx;
}

.note {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  background: var(--gray-soft);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

/* 营养素三栏 */
.macros {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.macro {
  flex: 1;
  text-align: center;
}

.macro-num {
  font-size: 32rpx;
  font-weight: 600;
}

.macro-label {
  font-size: 24rpx;
  color: var(--muted);
}

/* 餐食通用 */
.meal-head {
  display: flex;
  align-items: center;
}

.meal-label {
  font-size: 32rpx;
  font-weight: 600;
}

.meal-time {
  font-size: 26rpx;
  color: var(--muted);
  margin-left: 12rpx;
}

.list-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.list-row:last-child {
  border-bottom: none;
}

/* 文字里的暖豆小图标 */
.bean-inline {
  width: 1.2em;
  height: 1.2em;
  vertical-align: -0.25em;
  margin-right: 4rpx;
}

/* 早 / 午 / 晚打卡印章 */
.stamps {
  display: flex;
  gap: 12rpx;
  margin: 10rpx 0;
}

.stamp {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  box-sizing: border-box;
  color: #fff;
}

.stamp-green {
  background: var(--green);
}

.stamp-yellow {
  background: var(--yellow);
}

.stamp-red {
  background: var(--red);
}

.stamp-done {
  background: var(--gray);
}

.stamp-none {
  border: 3rpx dashed var(--gray);
  color: var(--gray);
}

/* 准时拍的那顿：金边 + 角上一个「准」 */
.stamp-on {
  position: relative;
  box-shadow: 0 0 0 5rpx #f0b429;
}

.stamp-on::after {
  content: '准';
  position: absolute;
  right: -16rpx;
  top: -16rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #f0b429;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

/* 日历格子里的小印章：只要颜色 */
.stamps-small {
  gap: 4rpx;
  justify-content: center;
  margin: 4rpx 0 0;
}

.stamps-small .stamp {
  width: 20rpx;
  height: 20rpx;
  font-size: 0;
  border-width: 2rpx;
}

.stamps-small .stamp-on {
  box-shadow: 0 0 0 3rpx #f0b429;
}

.stamps-small .stamp-on::after {
  display: none;
}

/* ---------------------------------------------------------------- 打卡动效（docs/superpowers/specs/2026-10-25-checkin-effects-design.md）
   都很短、只播一次（呼吸除外）；结束的样子就是平时的样子（fill-mode 用 backwards，不挡按压效果）；
   依次出现用 fx-d1～fx-d8（每档 100ms）；页面根节点加 fx-skip 就全部跳到结束 */
@keyframes fx-rise {
  from { opacity: 0; transform: translateY(32rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fx-pop {
  0% { opacity: 0; transform: scale(0.3); }
  70% { opacity: 1; transform: scale(1.15); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes fx-stamp {
  0% { opacity: 0; transform: scale(1.6) rotate(-12deg); }
  55% { opacity: 1; transform: scale(0.92) rotate(4deg); }
  100% { opacity: 1; transform: scale(1) rotate(0deg); }
}

@keyframes fx-ink {
  0% { opacity: 0.6; transform: scale(0.8); }
  100% { opacity: 0; transform: scale(1.9); }
}

@keyframes fx-breathe {
  0%, 100% { box-shadow: 0 4rpx 16rpx rgba(80, 60, 30, 0.05), 0 0 0 0 rgba(78, 125, 91, 0); }
  50% { box-shadow: 0 4rpx 16rpx rgba(80, 60, 30, 0.05), 0 0 0 14rpx rgba(78, 125, 91, 0.16); }
}

@keyframes fx-breathe-warn {
  0%, 100% { box-shadow: 0 4rpx 16rpx rgba(80, 60, 30, 0.05), 0 0 0 0 rgba(217, 130, 43, 0); }
  50% { box-shadow: 0 4rpx 16rpx rgba(80, 60, 30, 0.05), 0 0 0 14rpx rgba(217, 130, 43, 0.26); }
}

@keyframes fx-nudge {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.035); }
}

.fx-rise { animation: fx-rise 0.45s cubic-bezier(0.2, 0.8, 0.3, 1) backwards; }
.fx-pop { animation: fx-pop 0.35s ease-out backwards; }
.fx-d1 { animation-delay: 100ms; }
.fx-d2 { animation-delay: 200ms; }
.fx-d3 { animation-delay: 300ms; }
.fx-d4 { animation-delay: 400ms; }
.fx-d5 { animation-delay: 500ms; }
.fx-d6 { animation-delay: 600ms; }
.fx-d7 { animation-delay: 700ms; }
.fx-d8 { animation-delay: 800ms; }

/* 盖章：落下、歪一下回正，周围一圈墨晕开；准时的「准」再晚一点跳出来 */
.fx-stamp {
  position: relative;
  animation: fx-stamp 0.5s cubic-bezier(0.3, 1.4, 0.5, 1) 0.15s backwards;
}

.fx-stamp::before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(160, 90, 40, 0.45);
  opacity: 0;
  animation: fx-ink 0.7s ease-out 0.35s forwards;
}

.fx-stamp.stamp-on::after {
  animation: fx-pop 0.3s ease-out 0.55s backwards;
}

/* 首页「下一顿」：饭点内慢慢呼吸，过点了琥珀色、快一点；按钮轻轻一胀一缩 */
.fx-breathe { animation: fx-breathe 4s ease-in-out infinite; }
.fx-breathe-warn { animation: fx-breathe-warn 2.5s ease-in-out infinite; }
.fx-nudge { animation: fx-nudge 2s ease-in-out infinite; }

/* 按下去缩一点，松手弹回：按钮用自带的 button-hover，卡片、小块用 hover-class="fx-press"（选项小块 .chip 的过渡在上面） */
button,
.card {
  transition: transform 0.15s, opacity 0.15s;
}

button.button-hover {
  transform: scale(0.96);
}

.fx-press {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 点一下就跳到结束 */
.fx-skip .fx-rise,
.fx-skip .fx-pop,
.fx-skip .fx-stamp,
.fx-skip .fx-stamp.stamp-on::after {
  animation: none;
}

.fx-skip .fx-stamp::before {
  display: none;
}
