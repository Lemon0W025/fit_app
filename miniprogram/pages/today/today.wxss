/* 页面大标题：Starbucks Green */
.greeting {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand);
  margin: 8rpx 8rpx 24rpx;
}

/* 暖豆卡是奖励卡（金色奶油底 + 金边，见 app.wxss 的 .reward-card） */
.beans-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.beans-card-icon {
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
}

.beans-card-body {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.beans-card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--gold-ink);
}

.beans-card-streak {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.beans-card-arrow {
  font-size: 44rpx;
  color: var(--gold);
  margin-left: 8rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--muted);
}

/* 热量圆环（components/ring）居中 */
.hero-ring {
  display: flex;
  justify-content: center;
  margin: 24rpx 0 8rpx;
}

/* 超了才多说一句（还能吃多少圆环里已经写了） */
.hero-status {
  margin-top: 16rpx;
  font-size: 30rpx;
  text-align: center;
}

.hero-status-over {
  color: var(--red);
}

.meal {
  display: flex;
  padding: 24rpx;
}

.meal-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: var(--gray-soft);
}

.meal-thumb-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.meal-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.meal-kcal {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand);
  margin-top: 4rpx;
}

.meal-kcal-failed {
  color: var(--gray);
}

.meal-comment {
  font-size: 28rpx;
  color: var(--muted);
  margin-top: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.summary-text {
  white-space: pre-wrap;
  line-height: 1.8;
}

/* 首页「下一顿」大卡：深绿横幅（.band），白字；按钮白底绿字；
   能得多少暖豆是金色胶囊；过点了标题换成暖橙、呼吸光也是暖橙 */
.next-card {
  padding: 40rpx 36rpx 36rpx;
}

.next-title {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.3;
}

.next-card-warn .next-title {
  color: #ffc98a;
}

.next-sub {
  font-size: 32rpx;
  margin-top: 12rpx;
  color: var(--on-dark-soft);
}

.next-reward {
  display: inline-block;
  margin-top: 20rpx;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--gold);
  color: var(--gold-light);
  font-size: 28rpx;
  font-weight: 600;
}

.next-btn {
  margin-top: 32rpx;
  margin-bottom: 0;
}

.next-link {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

/* 新手三步：浅绿底 + 绿边 */
.guide {
  background: var(--primary-wash);
  box-shadow: var(--shadow-card), inset 0 0 0 3rpx var(--primary);
}

.guide-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.guide-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand);
}

.guide-hide {
  padding: 8rpx 12rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.guide-step {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-radius: 16rpx;
  transition: transform 150ms;
}

.guide-mark {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  border: 3rpx solid var(--primary);
  background: #fff;
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
  box-sizing: content-box;
}

.guide-label {
  flex: 1;
  font-size: 34rpx;
}

.guide-go {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
}

.guide-done .guide-mark {
  background: var(--primary);
  color: #fff;
}

.guide-done .guide-label {
  color: var(--muted);
  text-decoration: line-through;
}

