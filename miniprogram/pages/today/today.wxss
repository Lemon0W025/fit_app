/* 首页「今日」：便当盒风格（docs/superpowers/specs/2026-11-07-ui-bento-design.md） */
.today {
  padding-bottom: 48rpx;
}

/* 顶上：问好 + 日期，右边圆钮 */
.top {
  display: flex;
  align-items: center;
  margin: 8rpx 4rpx 32rpx;
}

.top-text {
  flex: 1;
  min-width: 0;
}

.greeting {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.25;
}

.top-date {
  margin-top: 4rpx;
  font-size: 30rpx;
  color: var(--muted);
}

/* ---------------------------------------------------------------- 下一顿：黑色大卡 */
.hero {
  position: relative;
  overflow: hidden;
  padding: 36rpx 36rpx 40rpx;
  background: var(--ink);
  color: #fff;
}

/* 右上角一圈淡淡的柠檬绿大圆环，当装饰 */
.hero::after {
  content: '';
  position: absolute;
  right: -120rpx;
  top: -140rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 56rpx solid rgba(196, 239, 90, 0.1);
  pointer-events: none;
}

.hero-warn::after {
  border-color: rgba(255, 179, 122, 0.14);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.hero .chip-icon {
  background: rgba(255, 255, 255, 0.12);
}

.hero .chip-icon image {
  filter: invert(1);
}

.hero-kicker {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
}

.hero-pill {
  flex-shrink: 0;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--lime);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.hero-warn .hero-pill {
  background: var(--peach);
}

.hero-big {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  font-size: 148rpx;
  color: #fff;
}

.hero-warn .hero-big {
  color: var(--peach);
}

.hero-line {
  margin-top: 12rpx;
  font-size: 32rpx;
  color: var(--on-dark-soft);
}

.hero-reward {
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 8rpx 24rpx 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(245, 165, 36, 0.18);
  color: #ffc864;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-bean {
  width: 44rpx;
  height: 44rpx;
  margin-right: 8rpx;
}

.hero-btn {
  margin-top: 32rpx !important;
  margin-bottom: 0 !important;
}

.hero-link {
  display: inline-flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  font-size: 30rpx;
  font-weight: 700;
}

.hero-link .btn-icon {
  width: 40rpx;
  height: 40rpx;
  vertical-align: 0;
}

/* ---------------------------------------------------------------- 今天吃了多少：柠檬绿卡 */
.intake-body {
  display: flex;
  align-items: center;
}

.intake-left {
  flex: 1;
  min-width: 0;
}

.intake-pct {
  font-size: 132rpx;
}

.intake-pct-unit {
  font-size: 64rpx;
  margin-left: 4rpx;
}

.intake-status {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--lime-ink);
}

.intake-over {
  color: var(--red);
}

/* ---------------------------------------------------------------- 三大营养素 */
.mac + .mac {
  margin-top: 28rpx;
}

.mac-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.mac-label {
  font-size: 28rpx;
  color: var(--muted);
}

.mac-val {
  font-size: 28rpx;
  color: var(--muted);
}

.mac-got {
  margin-right: 6rpx;
  font-family: var(--font-num);
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
}

.mac-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.mac-pct {
  flex-shrink: 0;
  width: 132rpx;
  font-size: 44rpx;
}

.mac-bar {
  flex: 1;
}

/* ---------------------------------------------------------------- 今天的暖豆 */
.beans-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.beans-num {
  font-size: 96rpx;
  color: var(--bean-ink);
}

.beans-num .num-unit {
  color: var(--bean-ink);
}

.beans-stamps {
  gap: 20rpx;
  margin: 0;
}

.beans-stamps .stamp {
  width: 72rpx;
  height: 72rpx;
  font-size: 30rpx;
}

.beans-line {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--bean-ink);
}

/* ---------------------------------------------------------------- 今天的打卡 */
.empty-card {
  display: flex;
  align-items: center;
  color: var(--muted);
}

.empty-icon {
  margin-right: 24rpx;
}

.meal {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.meal-thumb {
  width: 152rpx;
  height: 152rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
  background: var(--chip);
}

.meal-thumb-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.meal-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.meal-kcal {
  font-family: var(--font-num);
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 2rpx;
}

.meal-kcal-failed {
  color: var(--gray);
}

.meal-comment {
  font-size: 28rpx;
  color: var(--muted);
  margin-top: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.meal-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  align-self: stretch;
  margin-left: 12rpx;
}

.meal-side .badge {
  margin-left: 0;
}

.meal-go {
  width: 36rpx;
  height: 36rpx;
  margin-top: auto;
}

.summary-text {
  white-space: pre-wrap;
  line-height: 1.8;
}

/* ---------------------------------------------------------------- 新手三步 */
.guide {
  background: var(--lime-wash);
  box-shadow: var(--shadow-card), inset 0 0 0 3rpx var(--lime);
}

.guide .chip-icon {
  background: #fff;
}

.guide-hide {
  padding: 8rpx 12rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.guide-step {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-radius: 24rpx;
  transition: transform 150ms;
}

.guide-mark {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #fff;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.guide-label {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
}

.guide-go {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.guide-done .guide-mark {
  background: var(--lime);
}

.guide-done .guide-label {
  color: var(--muted);
  font-weight: 400;
  text-decoration: line-through;
}
