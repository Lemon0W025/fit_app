.greeting {
  font-size: 40rpx;
  font-weight: 700;
  margin: 8rpx 8rpx 24rpx;
}

.beans-card {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(90deg, #fff4e0 0%, #ffffff 80%);
}

.beans-card-icon {
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
}

.beans-card-body {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.beans-card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #b8763a;
}

.beans-card-streak {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.beans-card-arrow {
  font-size: 44rpx;
  color: var(--gray);
  margin-left: 8rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--muted);
}

/* 热量圆环（components/ring）居中 */
.hero-ring {
  display: flex;
  justify-content: center;
  margin: 24rpx 0 8rpx;
}

/* 超了才多说一句（还能吃多少圆环里已经写了） */
.hero-status {
  margin-top: 16rpx;
  font-size: 30rpx;
  text-align: center;
}

.hero-status-over {
  color: var(--red);
}

.meal {
  display: flex;
  padding: 24rpx;
}

.meal-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--gray-soft);
}

.meal-thumb-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.meal-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.meal-kcal {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
  margin-top: 4rpx;
}

.meal-kcal-failed {
  color: var(--gray);
}

.meal-comment {
  font-size: 28rpx;
  color: var(--muted);
  margin-top: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.summary-text {
  white-space: pre-wrap;
  line-height: 1.8;
}

/* 首页「下一顿」大卡 */
.next-card {
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #eaf5ec 0%, #ffffff 85%);
}

.next-card-warn {
  background: linear-gradient(135deg, #fff1e0 0%, #ffffff 85%);
}

.next-title {
  font-size: 48rpx;
  font-weight: 700;
}

.next-card-warn .next-title {
  color: #d9822b;
}

.next-sub {
  font-size: 32rpx;
  margin-top: 8rpx;
  color: var(--muted);
}

.next-reward {
  font-size: 30rpx;
  margin-top: 6rpx;
  color: #b9741f;
}

.next-btn {
  margin-top: 24rpx;
}

.next-link {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: var(--primary);
}

/* 新手三步：一行（做完几步 · 下一步 · 去做 · 不用了） */
.guide {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  border: 3rpx solid var(--primary);
  transition: transform 150ms;
}

.guide-mark {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
}

.guide-body {
  flex: 1;
  min-width: 0;
}

.guide-title {
  font-size: 26rpx;
  color: var(--muted);
}

.guide-label {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.guide-go {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
}

.guide-hide {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 16rpx 0 16rpx 16rpx;
  font-size: 26rpx;
  color: var(--muted);
}


/* 亲友看板：亲友的赞 */
.likes-note {
  padding: 24rpx 32rpx;
  background: var(--red-soft);
  color: var(--red);
  font-size: 30rpx;
  font-weight: 600;
}

.meal-likes {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--red);
}
