<view class="page">
  <view wx:if="{{loading}}" class="empty">小暖正在翻今天的记录…</view>

  <block wx:if="{{view}}">
    <view class="greeting fx-rise">{{greeting}}</view>

    <view wx:if="{{card}}" class="fx-rise fx-d1">
      <view class="card next-card {{card.warn ? 'next-card-warn fx-breathe-warn' : card.state === 'open' ? 'fx-breathe' : ''}}">
        <view class="next-title">{{card.title}}</view>
        <view wx:if="{{card.sub}}" class="next-sub">{{card.sub}}</view>
        <view wx:if="{{!card.small}}" class="{{card.warn || card.state === 'open' ? 'fx-nudge' : ''}}">
          <button class="btn-primary btn-big next-btn" data-meal-type="{{card.mealType}}" bindtap="goCheckin">{{card.button}}</button>
        </view>
        <view wx:else class="next-link" data-meal-type="{{card.mealType}}" bindtap="goCheckin">{{card.button}} ›</view>
      </view>
    </view>

    <view wx:if="{{daily}}" class="card beans-card fx-rise fx-d2" hover-class="fx-press" bindtap="goGarden">
      <image class="beans-card-icon" src="/images/garden/ui/bean.png" mode="aspectFit" />
      <view class="beans-card-body">
        <view class="beans-card-title">{{daily.title}}</view>
        <view class="stamps">
          <view wx:for="{{daily.stamps}}" wx:key="key" class="stamp {{item.cls}} fx-pop" style="animation-delay: {{300 + index * 100}}ms">{{item.label}}</view>
        </view>
        <view class="beans-card-hint">{{daily.hint}}</view>
        <view wx:if="{{daily.streakText}}" class="beans-card-streak">{{daily.streakText}}</view>
        <view wx:if="{{daily.onTimeText}}" class="beans-card-streak">⏰ {{daily.onTimeText}}</view>
      </view>
      <text class="beans-card-arrow">›</text>
    </view>

    <view class="card hero fx-rise fx-d3">
      <view class="hero-top">
        <text>{{view.dateLabel}}</text>
        <text>每日预算 {{view.dailyKcal}} 千卡</text>
      </view>
      <view class="hero-ring">
        <ring value="{{view.totals.kcal}}" max="{{view.dailyKcal}}" size="{{320}}" />
      </view>
      <view wx:if="{{view.over}}" class="hero-status hero-status-over">{{view.statusText}}</view>
      <view class="macros">
        <view class="macro">
          <view class="macro-num">{{view.totals.protein}}g</view>
          <view class="macro-label">蛋白质</view>
        </view>
        <view class="macro">
          <view class="macro-num">{{view.totals.carbs}}g</view>
          <view class="macro-label">碳水</view>
        </view>
        <view class="macro">
          <view class="macro-num">{{view.totals.fat}}g</view>
          <view class="macro-label">脂肪</view>
        </view>
      </view>
    </view>

    <view class="section-title">今天的打卡</view>
    <view wx:if="{{view.meals.length === 0}}" class="card empty">还没有打卡哦，吃饭前先拍一张给小暖看看～</view>
    <view wx:for="{{view.meals}}" wx:key="_id" class="card meal fx-rise" hover-class="fx-press" style="animation-delay: {{400 + index * 80}}ms" data-id="{{item._id}}" bindtap="openMeal">
      <image wx:if="{{item.fileID}}" class="meal-thumb" src="{{item.fileID}}" mode="aspectFill" lazy-load />
      <view wx:else class="meal-thumb meal-thumb-text">✍️</view>
      <view class="meal-body">
        <view class="meal-head">
          <text class="meal-label">{{item.label}}</text>
          <text class="meal-time">{{item.timeText}}</text>
          <text wx:if="{{item.ratingText}}" class="badge badge-{{item.ratingClass}}">{{item.ratingText}}</text>
        </view>
        <view class="meal-kcal {{item.ratingClass === 'failed' ? 'meal-kcal-failed' : ''}}">{{item.kcalText}}</view>
        <view class="meal-comment">{{item.commentText}}</view>
      </view>
    </view>

    <view class="section-title">小暖的今日总结</view>
    <view class="card">
      <view wx:if="{{view.summary}}" class="summary-text">{{view.summary.text}}</view>
      <view wx:else class="muted">吃完今天最后一餐，让小暖帮你复盘一下吧。</view>
      <button class="btn-plain" bindtap="generateSummary" loading="{{summarizing}}" disabled="{{summarizing || view.meals.length === 0}}">{{view.summary ? '重新总结' : '生成今日总结'}}</button>
    </view>
  </block>
</view>
