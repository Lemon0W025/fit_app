/* 使用说明：大字、一段一张卡，面向长辈 */
.manual-lead {
  margin: 8rpx 8rpx 24rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--text);
}

.manual-card {
  margin-bottom: 24rpx;
}

.manual-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.manual-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.manual-emoji {
  width: 64rpx;
  margin-right: 16rpx;
  font-size: 48rpx;
  text-align: center;
  flex-shrink: 0;
}

.manual-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
}

.manual-line {
  display: flex;
  margin-top: 14rpx;
}

.manual-dot {
  width: 32rpx;
  flex-shrink: 0;
  font-size: 34rpx;
  line-height: 1.6;
  color: var(--primary);
  font-weight: 700;
}

.manual-text {
  flex: 1;
  font-size: 32rpx;
  line-height: 1.6;
  color: #3f3830;
}

.manual-replay {
  margin-top: 16rpx;
  margin-bottom: 48rpx;
}
