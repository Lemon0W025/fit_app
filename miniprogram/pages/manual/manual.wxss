/* 使用说明：大字、一段一张卡，面向长辈 */
.manual-lead {
  margin: 8rpx 8rpx 24rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--text);
}

.manual-card {
  margin-bottom: 24rpx;
}

.manual-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.manual-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--chip);
  flex-shrink: 0;
}

.manual-emoji {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--chip);
  font-size: 40rpx;
  line-height: 72rpx;
  text-align: center;
  flex-shrink: 0;
}

.manual-title {
  font-size: 38rpx;
  font-weight: 800;
}

.manual-line {
  display: flex;
  margin-top: 14rpx;
}

.manual-dot {
  width: 32rpx;
  flex-shrink: 0;
  font-size: 34rpx;
  line-height: 1.6;
  color: var(--lime-deep);
  font-weight: 800;
}

.manual-text {
  flex: 1;
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--text);
}

.manual-replay {
  margin-top: 16rpx;
  margin-bottom: 48rpx;
}
