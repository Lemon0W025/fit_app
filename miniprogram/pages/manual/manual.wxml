<view class="page manual">
  <view class="manual-lead">小暖自律打卡是这样用的：每顿饭拍张照，小暖帮你算热量；按饭点拍还能得暖豆，拿去营地养小动物。</view>

  <view wx:for="{{sections}}" wx:key="key" class="card manual-card">
    <view class="manual-head">
      <image wx:if="{{item.icon}}" class="manual-icon" src="{{item.icon}}" mode="aspectFit" />
      <text wx:else class="manual-emoji">{{item.emoji}}</text>
      <text class="manual-title">{{item.title}}</text>
    </view>
    <view wx:for="{{item.lines}}" wx:for-item="line" wx:for-index="n" wx:key="n" class="manual-line">
      <text class="manual-dot">·</text>
      <text class="manual-text">{{line}}</text>
    </view>
  </view>

  <button class="btn-primary btn-big manual-replay" bindtap="replayTour">再看一遍新手导览</button>
</view>
