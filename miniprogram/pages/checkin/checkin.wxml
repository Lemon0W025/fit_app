<view class="page">
  <view class="section-title section-first">这是哪一餐？</view>
  <segmented options="{{mealTypes}}" value="{{mealType}}" bindchange="pickMealType" />
  <view wx:if="{{timingText}}" class="timing {{timingOn ? 'timing-on' : ''}}">{{timingText}}</view>

  <view class="section-title">拍下这一餐</view>
  <view wx:if="{{!photo}}" class="card photo-picker" bindtap="choosePhoto">
    <view class="photo-icon">📷</view>
    <view class="photo-tip">点这里拍照，或从相册选</view>
    <view class="muted small">把所有菜都拍进去，旁边有碗筷更容易估份量</view>
  </view>
  <view wx:else class="card photo-box">
    <image class="photo" src="{{photo}}" mode="aspectFill" bindtap="previewPhoto" />
    <view class="photo-actions">
      <text class="link" bindtap="choosePhoto">重拍</text>
      <text class="link link-muted" bindtap="removePhoto">不用照片</text>
    </view>
  </view>

  <view class="section-title">想跟小暖说点什么（选填）</view>
  <!-- textarea 是原生组件，提交时换成普通文字，避免盖住加载层 -->
  <textarea wx:if="{{!submitting}}" class="note" value="{{note}}" bindinput="onNote" maxlength="200" auto-height placeholder="比如：米饭只吃了半碗。没拍照的话，直接写吃了什么也行" />
  <view wx:else class="note">{{note}}</view>

  <button class="btn-primary btn-big" bindtap="submit" disabled="{{submitting}}">交给小暖看看</button>

  <view wx:if="{{submitting}}" class="overlay">
    <view class="overlay-card fx-pop">
      <!-- 小暖在看：照片（没照片就是写的字）上一道光来回扫 -->
      <view class="scan">
        <image wx:if="{{photo}}" class="scan-photo" src="{{photo}}" mode="aspectFill" />
        <view wx:else class="scan-note">{{note}}</view>
        <view class="scan-light"></view>
      </view>
      <view class="overlay-stage">{{stage}}</view>
      <view class="steps">
        <view wx:for="{{steps}}" wx:key="label" class="step step-{{item.state}}">
          <view class="step-dot">{{item.state === 'done' ? '✓' : ''}}</view>
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="muted small">一般需要 10～30 秒，请稍等</view>
    </view>
  </view>
</view>
