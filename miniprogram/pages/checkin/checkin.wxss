.section-first {
  margin-top: 16rpx;
}

.photo-picker {
  text-align: center;
  padding: 64rpx 32rpx;
  border: 4rpx dashed var(--line);
  box-shadow: none;
}

.photo-icon {
  font-size: 80rpx;
  line-height: 1.2;
}

.photo-tip {
  font-size: 32rpx;
  font-weight: 600;
  margin: 12rpx 0;
}

.photo-box {
  padding: 16rpx;
}

.photo {
  width: 100%;
  height: 480rpx;
  border-radius: 16rpx;
  display: block;
}

.photo-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 8rpx;
}

.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(47, 42, 36, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.overlay-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 48rpx 56rpx;
  text-align: center;
  width: 70%;
}

.overlay-stage {
  font-size: 32rpx;
  font-weight: 600;
  margin: 24rpx 0 8rpx;
}

.spinner {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 50%;
  border: 8rpx solid var(--primary-soft);
  border-top-color: var(--primary);
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.timing {
  font-size: 30rpx;
  margin: 12rpx 8rpx 0;
  color: #d9822b;
}

.timing-on {
  color: var(--primary);
  font-weight: 700;
}
