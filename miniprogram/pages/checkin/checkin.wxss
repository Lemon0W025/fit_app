.section-first {
  margin-top: 16rpx;
}

.photo-picker {
  text-align: center;
  padding: 64rpx 32rpx;
  border: 4rpx dashed var(--line);
  box-shadow: none;
}

.photo-icon {
  font-size: 80rpx;
  line-height: 1.2;
}

.photo-tip {
  font-size: 32rpx;
  font-weight: 600;
  margin: 12rpx 0;
}

/* 拍照小贴士：左对齐四行大字 */
.tips {
  display: inline-block;
  margin-top: 16rpx;
  text-align: left;
}

.tip {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--muted);
}

.tip-icon {
  display: inline-block;
  width: 52rpx;
}

.photo-box {
  padding: 16rpx;
}

.photo {
  width: 100%;
  height: 480rpx;
  border-radius: 16rpx;
  display: block;
}

.photo-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 8rpx;
}

.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(47, 42, 36, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.overlay-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 48rpx 56rpx;
  text-align: center;
  width: 70%;
}

.overlay-stage {
  font-size: 32rpx;
  font-weight: 600;
  margin: 24rpx 0 8rpx;
}

/* 等小暖：照片缩成一张小卡，一道斜光来回扫 */
.scan {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--gray-soft);
  box-shadow: 0 8rpx 24rpx rgba(80, 60, 30, 0.15);
}

.scan-photo {
  width: 100%;
  height: 100%;
  display: block;
}

.scan-note {
  padding: 24rpx;
  font-size: 28rpx;
  text-align: left;
  color: var(--text);
  overflow: hidden;
  height: 100%;
  box-sizing: border-box;
}

.scan-light {
  position: absolute;
  left: -50%;
  top: -60%;
  width: 200%;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.55) 50%, rgba(255, 255, 255, 0) 100%);
  transform: rotate(-12deg);
  animation: scan 1.6s ease-in-out infinite;
}

@keyframes scan {
  0% { top: -60%; }
  100% { top: 110%; }
}

/* 三步：做完的打勾，正在做的点在跳 */
.steps {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  margin: 8rpx 0 20rpx;
  font-size: 28rpx;
}

.step {
  display: flex;
  align-items: center;
  color: var(--gray);
}

.step-dot {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  box-sizing: border-box;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
  color: #fff;
}

.step-done {
  color: var(--primary);
}

.step-done .step-dot {
  background: var(--primary);
  border-color: var(--primary);
}

.step-now {
  color: var(--text);
  font-weight: 600;
}

.step-now .step-dot {
  border-color: var(--primary);
  animation: fx-nudge 0.9s ease-in-out infinite;
}

.timing {
  font-size: 30rpx;
  margin: 12rpx 8rpx 0;
  color: #d9822b;
}

.timing-on {
  color: var(--primary);
  font-weight: 700;
}
