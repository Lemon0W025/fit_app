.empty { padding: 120rpx 0; text-align: center; color: var(--muted); }
.beans { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.beans-icon { width: 56rpx; height: 56rpx; }
.beans-num { font-family: var(--font-num); font-size: 52rpx; font-weight: 800; color: var(--bean-ink); }
.beans-unit { color: var(--muted); }
.group-title { font-size: 36rpx; font-weight: 800; margin-bottom: 16rpx; }
.grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.cell { width: calc((100% - 40rpx) / 3); display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.cell-image { width: 160rpx; height: 130rpx; }
.cell-name { font-size: 28rpx; text-align: center; }
/* 价钱按钮：一格只有两百 rpx 来宽，比全局的主按钮小一号（以前挂的 btn-small 只在营地页有定义，这里不起作用）；
   买不起的灰着、写「还差 N 暖豆」，字再小一点才放得下 */
button.cell-btn { margin: 4rpx 0 0; padding: 6rpx 0; font-size: 28rpx; }
button.cell-btn-short { font-size: 26rpx; font-weight: 500; }
/* 灰底深字（全局的灰按钮是浅绿底白字，这么小的字看不清） */
button.btn-primary.cell-btn-short[disabled] { background: var(--gray-soft) !important; color: var(--muted) !important; }
.card.empty { padding: 64rpx 32rpx; }

/* 标签筛选（docs/superpowers/specs/2026-10-27-ui-controls-design.md 第 4 节）：单选；没选中浅色底，选中主题绿实色白字；
   按下缩到 0.96 再回来，底色、字色、边框 200ms 过渡。往下翻的时候贴在顶上 */
.tags {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  gap: 12rpx;
  margin: 0 -8rpx 20rpx;
  padding: 12rpx 8rpx;
  background: var(--bg);
}

.tag {
  flex: 1 1 auto;
  height: 68rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  line-height: 64rpx;
  text-align: center;
  white-space: nowrap;
  font-size: 30rpx;
  box-sizing: border-box;
  background: var(--card);
  color: var(--text);
  border: 2rpx solid transparent;
  transition: transform 0.15s, background-color 0.2s, color 0.2s, border-color 0.2s;
}

.tag-on {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
  font-weight: 600;
}

.tag-press {
  transform: scale(0.95);
}
