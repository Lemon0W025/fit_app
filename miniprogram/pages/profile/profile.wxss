.welcome {
  background: var(--house);
  color: #fff;
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.welcome-text {
  color: var(--on-dark-soft);
}

.field-last {
  margin-bottom: 0;
}

.budget {
  text-align: center;
}

.budget-num {
  font-size: 76rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.3;
  margin: 8rpx 0;
}

.budget-unit {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--muted);
}

.disclaimer {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
  padding: 0 8rpx;
}

.meal-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.meal-time-word {
  font-size: 32rpx;
}

.meal-time-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand);
}

/* 饭点提醒入口 */
.remind-entry {
  display: flex;
  align-items: center;
}

.remind-entry-body {
  flex: 1;
}

.remind-entry-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.remind-entry-arrow {
  font-size: 40rpx;
  color: var(--gray);
}

.reset-entry .remind-entry-title {
  color: var(--red);
}

