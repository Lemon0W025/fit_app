.welcome {
  background: var(--house);
  color: #fff;
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.welcome-text {
  color: var(--on-dark-soft);
}

.field-last {
  margin-bottom: 0;
}

.budget {
  text-align: left;
}

.budget-num {
  font-size: 112rpx;
  margin: 0 0 12rpx;
}

.budget-unit {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.disclaimer {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
  padding: 0 8rpx;
}

.meal-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.meal-time-word {
  font-size: 32rpx;
}

.meal-time-value {
  font-family: var(--font-num);
  font-size: 38rpx;
  font-weight: 800;
}

/* 饭点提醒入口 */
.remind-entry {
  display: flex;
  align-items: center;
}

.remind-entry-body {
  flex: 1;
}

.remind-entry-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.remind-entry-arrow {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
}

.reset-entry .chip-icon {
  background: var(--red-soft);
}

.reset-entry .remind-entry-title {
  color: var(--red);
}

