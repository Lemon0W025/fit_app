.welcome {
  background: var(--house);
  color: #fff;
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.welcome-text {
  color: var(--on-dark-soft);
}

.field-last {
  margin-bottom: 0;
}

.budget {
  text-align: left;
}

.budget-num {
  font-size: 112rpx;
  margin: 0 0 12rpx;
}

.budget-unit {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.disclaimer {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
  padding: 0 8rpx;
}

.meal-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.meal-time-word {
  font-size: 32rpx;
}

.meal-time-value {
  font-family: var(--font-num);
  font-size: 38rpx;
  font-weight: 800;
}

/* 饭点提醒入口 */
.remind-entry {
  display: flex;
  align-items: center;
}

.remind-entry-body {
  flex: 1;
}

.remind-entry-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.remind-entry-arrow {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
}

.reset-entry .chip-icon {
  background: var(--red-soft);
}

.reset-entry .remind-entry-title {
  color: var(--red);
}


/* 亲友看板：邀请亲友、谁在看我的打卡、我关注的亲友 */
button.family-invite {
  margin: 24rpx 0 0;
}

.family-list {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.family-list-title {
  font-size: 28rpx;
  color: var(--muted);
}

.family-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.family-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
}

.family-remove {
  flex-shrink: 0;
  padding: 16rpx 0 16rpx 32rpx;
  font-size: 30rpx;
  color: var(--red-text);
}

.family-following {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 600;
}

.family-invite + .family-following,
.family-list + .family-following {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}
