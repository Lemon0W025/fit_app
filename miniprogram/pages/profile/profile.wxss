.welcome {
  background: var(--primary-soft);
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 12rpx;
}

.welcome-text {
  color: var(--text);
}

.field-last {
  margin-bottom: 0;
}

.budget {
  text-align: center;
}

.budget-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.3;
  margin: 8rpx 0;
}

.budget-unit {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--muted);
}

.disclaimer {
  font-size: 24rpx;
  color: var(--gray);
  line-height: 1.6;
  padding: 0 8rpx;
}

.meal-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.meal-time-word {
  font-size: 32rpx;
}

.meal-time-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary);
}

/* 饭点提醒入口 */
.remind-entry {
  display: flex;
  align-items: center;
}

.remind-entry-body {
  flex: 1;
}

.remind-entry-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.remind-entry-arrow {
  font-size: 40rpx;
  color: var(--gray);
}

