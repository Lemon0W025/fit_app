.welcome {
  background: var(--primary-soft);
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 12rpx;
}

.welcome-text {
  color: var(--text);
}

.field-last {
  margin-bottom: 0;
}

.budget {
  text-align: center;
}

.budget-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.3;
  margin: 8rpx 0;
}

.budget-unit {
  font-size: 30rpx;
  font-weight: 400;
  color: var(--muted);
}

.disclaimer {
  font-size: 26rpx;
  color: var(--gray-text);
  line-height: 1.6;
  padding: 0 8rpx;
}

.meal-time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.meal-time-word {
  font-size: 32rpx;
}

.meal-time-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary);
}

/* 饭点提醒入口 */
.remind-entry {
  display: flex;
  align-items: center;
}

.remind-entry-body {
  flex: 1;
}

.remind-entry-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.remind-entry-arrow {
  font-size: 40rpx;
  color: var(--gray);
}

.reset-entry .remind-entry-title {
  color: var(--red, #d4543c);
}


/* 亲友看板：邀请亲友、谁在看我的打卡、我关注的亲友 */
button.family-invite {
  margin: 24rpx 0 0;
}

.family-list {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.family-list-title {
  font-size: 28rpx;
  color: var(--muted);
}

.family-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.family-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
}

.family-remove {
  flex-shrink: 0;
  padding: 16rpx 0 16rpx 32rpx;
  font-size: 30rpx;
  color: var(--red-text);
}

.family-following {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 600;
}

.family-invite + .family-following,
.family-list + .family-following {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}
