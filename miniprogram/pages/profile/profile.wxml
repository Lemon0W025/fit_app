<view class="page" wx:if="{{!loading}}">
  <view wx:if="{{isNew}}" class="card welcome">
    <view class="welcome-title">你好，我是小暖 👋</view>
    <view class="welcome-text">我会陪你每天好好吃饭、慢慢变轻。先告诉我一些基本情况，我来算算你每天吃多少合适。</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="field-label">怎么称呼你</view>
      <view class="input-wrap">
        <input class="field-input" value="{{form.nickname}}" data-field="nickname" bindinput="onInput" placeholder="比如：妈妈" maxlength="20" />
      </view>
    </view>

    <view class="field">
      <view class="field-label">性别</view>
      <segmented options="{{sexOptions}}" value="{{form.sex}}" data-field="sex" bindchange="onSegment" />
    </view>

    <view class="field-row">
      <view class="field">
        <view class="field-label">年龄</view>
        <view class="input-wrap">
          <input class="field-input" type="number" value="{{form.age}}" data-field="age" bindinput="onInput" placeholder="50" />
          <text class="unit">岁</text>
        </view>
      </view>
      <view class="field">
        <view class="field-label">身高</view>
        <view class="input-wrap">
          <input class="field-input" type="digit" value="{{form.heightCm}}" data-field="heightCm" bindinput="onInput" placeholder="160" />
          <text class="unit">cm</text>
        </view>
      </view>
    </view>

    <view class="field-row">
      <view class="field">
        <view class="field-label">现在体重</view>
        <view class="input-wrap">
          <input class="field-input" type="digit" value="{{form.weightKg}}" data-field="weightKg" bindinput="onInput" placeholder="65" />
          <text class="unit">kg</text>
        </view>
      </view>
      <view class="field">
        <view class="field-label">目标体重</view>
        <view class="input-wrap">
          <input class="field-input" type="digit" value="{{form.targetWeightKg}}" data-field="targetWeightKg" bindinput="onInput" placeholder="58" />
          <text class="unit">kg</text>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">平时活动量</view>
      <view class="chips chips-col">
        <view wx:for="{{activityOptions}}" wx:key="value" class="chip {{form.activity === item.value ? 'chip-on' : ''}}" hover-class="chip-press" hover-stay-time="100" data-field="activity" data-value="{{item.value}}" bindtap="onPick">{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">三餐时间（前后 1 小时内拍算准时）</view>
      <view wx:for="{{mealRows}}" wx:key="mealType" class="meal-time-row">
        <text class="meal-time-word">{{item.word}}</text>
        <picker mode="selector" range="{{item.options}}" value="{{item.index}}" data-meal-type="{{item.mealType}}" bindchange="onMealTime">
          <view class="meal-time-value">{{item.value}} ›</view>
        </picker>
      </view>
    </view>

    <view class="field field-last">
      <view class="field-label">忌口 / 饮食习惯（选填）</view>
      <view class="input-wrap">
        <input class="field-input" value="{{form.avoid}}" data-field="avoid" bindinput="onInput" placeholder="比如：不吃香菜、爱吃面食" maxlength="100" />
      </view>
    </view>
  </view>

  <view wx:if="{{previewKcal}}" class="card card-lime budget">
    <view class="card-head">
      <view class="chip-icon"><image src="/images/icons/target.svg" mode="aspectFit" /></view>
      <text class="card-head-title">按你的情况，每天建议吃</text>
    </view>
    <view class="budget-num num">{{previewKcal}}<text class="budget-unit"> 千卡</text></view>
    <view class="muted small">已经留出健康减重的空间，不会让你饿着。以后记体重时会自动调整。</view>
  </view>

  <button class="btn-primary btn-big" bindtap="save" loading="{{saving}}" disabled="{{saving}}">{{isNew ? '下一步：设饭点提醒' : '保存'}}</button>

  <view wx:if="{{!isNew}}" class="card remind-entry" hover-class="fx-press" bindtap="goRemind">
    <view class="chip-icon"><image src="/images/icons/bell.svg" mode="aspectFit" /></view>
    <view class="remind-entry-body">
      <view class="remind-entry-title">饭点提醒</view>
      <view class="muted small">手机闹钟、微信提醒，到点提醒你拍照</view>
    </view>
    <image class="remind-entry-arrow" src="/images/icons/chevron-off.svg" mode="aspectFit" />
  </view>

  <view class="card remind-entry" hover-class="fx-press" bindtap="goManual">
    <view class="chip-icon"><image src="/images/icons/book.svg" mode="aspectFit" /></view>
    <view class="remind-entry-body">
      <view class="remind-entry-title">使用说明</view>
      <view class="muted small">怎么拍照打卡、能得到什么、营地怎么玩</view>
    </view>
    <image class="remind-entry-arrow" src="/images/icons/chevron-off.svg" mode="aspectFit" />
  </view>

  <!-- 测试期间（云函数 config.testReset 开着）才有：清空自己的数据，从新手指引重新走一遍 -->
  <view wx:if="{{canReset}}" class="card remind-entry reset-entry" hover-class="fx-press" bindtap="startOver">
    <view class="chip-icon"><image src="/images/icons/refresh.svg" mode="aspectFit" /></view>
    <view class="remind-entry-body">
      <view class="remind-entry-title">从头再来（测试用）</view>
      <view class="muted small">清空档案、打卡、体重、营地，回到第一次打开的样子</view>
    </view>
    <image class="remind-entry-arrow" src="/images/icons/chevron-off.svg" mode="aspectFit" />
  </view>

  <view class="disclaimer">小暖的建议仅供日常参考，不能替代医生。如有糖尿病、高血压等慢性病，或正在孕期、哺乳期，请先咨询医生再控制饮食。</view>
</view>
