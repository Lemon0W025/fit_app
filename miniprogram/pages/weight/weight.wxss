.weight-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.weight-input {
  flex: 1;
}

button.btn-inline {
  width: 180rpx !important;
  margin: 0;
  padding: 24rpx 0;
  flex-shrink: 0;
}

.budget-tip {
  color: var(--lime-ink);
  font-weight: 700;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.latest-num {
  font-size: 120rpx;
}

.latest-unit {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--muted);
  margin-left: 8rpx;
}

.change {
  font-size: 30rpx;
  margin: 4rpx 0;
}

.chart {
  width: 100%;
  height: 400rpx;
  margin-top: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.7);
}
