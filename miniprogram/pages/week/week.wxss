.wk-head {
  display: flex;
  align-items: center;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.wk-head-body {
  flex: 1;
  text-align: center;
}

.wk-title {
  font-size: 40rpx;
  font-weight: 800;
}

.wk-label {
  margin-top: 4rpx;
  font-size: 28rpx;
  color: var(--muted);
}

/* 左右换周：圆钮（往前的那个把箭头翻过来） */
.wk-round {
  flex-shrink: 0;
  background: var(--chip);
  box-shadow: none;
}

.wk-flip {
  transform: rotate(180deg);
}

.wk-round-off {
  opacity: 0.3;
}

/* 四个数：两行两列 */
.wk-tiles {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.wk-tiles .wk-tile {
  margin: 0;
  padding: 24rpx 28rpx;
}

.wk-tile-label {
  font-size: 28rpx;
  color: var(--muted);
}

.wk-tile-num {
  margin-top: 4rpx;
  font-size: 60rpx;
  line-height: 1.2;
}

.wk-tile-unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: var(--muted);
}

/* 七根柱子：上面一排数字，中间柱子（预算一条虚线），下面星期和早午晚 */
.wk-nums {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.wk-kcal {
  flex: 1;
  min-width: 0;
  height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 40rpx;
  color: var(--muted);
  white-space: nowrap;
}

.wk-kcal.wk-col-today {
  color: var(--text);
  font-weight: 800;
}

.wk-chart {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  height: 280rpx;
}

.wk-track {
  position: relative;
  flex: 1;
  min-width: 0;
  border-radius: 16rpx 16rpx 0 0;
  background: var(--chip);
}

.wk-track.wk-col-future {
  background: transparent;
  border: 2rpx dashed var(--line);
  border-bottom: none;
}

.wk-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 16rpx 16rpx 0 0;
  background: var(--lime);
}

.wk-bar-over {
  background: var(--peach);
}

.wk-budget {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 1;
  height: 0;
  border-top: 3rpx dashed var(--ink);
  opacity: 0.55;
}

/* 预算写在卡片头上了，线上不再写字 */
.wk-budget-text {
  display: none;
}

.wk-days {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.wk-day {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.wk-weekday {
  font-size: 28rpx;
  color: var(--muted);
}

.wk-day.wk-col-today .wk-weekday {
  color: var(--text);
  font-weight: 800;
}

.wk-stamps {
  justify-content: center;
  min-height: 20rpx;
  margin-top: 8rpx;
}

.wk-legend {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--muted);
}

/* 小暖的话 */
.wk-line {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
}

.wk-dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  margin: 18rpx 16rpx 0 0;
  border-radius: 50%;
  background: var(--gray);
}

.wk-dot-good {
  background: var(--lime-deep);
}

.wk-dot-warn {
  background: var(--peach);
}

.wk-line-text {
  flex: 1;
  font-size: 32rpx;
  line-height: 1.6;
}

.wk-goal {
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: var(--lime-wash);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--lime-ink);
}
