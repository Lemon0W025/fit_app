.gain-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(90deg, #fff4e0 0%, #ffffff 80%);
}

.gain-icon {
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
}

.gain-body {
  flex: 1;
  margin-left: 16rpx;
}

.gain-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #d97a1e;
}

.gain-hint {
  font-size: 28rpx;
}

.gain-bonus {
  font-size: 30rpx;
  font-weight: 700;
  color: #c98a12;
}

.arrival-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(90deg, #fff4e0 0%, #ffffff 80%);
}

.arrival-image {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.arrival-body {
  flex: 1;
  margin-left: 16rpx;
}

.arrival-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #b8763a;
}

.arrival-link {
  font-size: 28rpx;
  color: var(--primary);
  margin-top: 6rpx;
}

.hero-photo {
  width: 100%;
  height: 520rpx;
  border-radius: 24rpx;
  display: block;
  margin-bottom: 24rpx;
}

.big-kcal {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary);
  margin-top: 12rpx;
}

.error-box {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--yellow-soft);
  color: var(--yellow);
  font-size: 30rpx;
}

.note-line {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.adjusted-note {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--yellow);
}

/* 吃了哪些：一道菜一行，整行能点 */
.dish-hint {
  margin: -8rpx 0 8rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.dish {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  margin: 0 -16rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  border-bottom: 2rpx solid var(--line);
  transition: transform 150ms, background-color 150ms;
}

.dish:last-child {
  border-bottom: none;
}

.dish-press {
  transform: scale(0.98);
  background-color: var(--gray-soft);
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 34rpx;
}

.dish-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--yellow-soft);
  color: var(--yellow);
  font-size: 24rpx;
}

.dish-sub {
  margin-top: 4rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.dish-kcal {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 32rpx;
  color: var(--muted);
}

.dish-go {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 40rpx;
  color: var(--gray);
}

/* 改份量的抽屉 */
.adj-preview {
  margin-top: 8rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
}

.adj-chips {
  flex-wrap: nowrap;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 4rpx;
}

/* 五个快捷按钮排一行 */
.adj-chips .chip {
  flex: 1 1 auto;
  padding: 16rpx 0;
  text-align: center;
  white-space: nowrap;
}

.adj-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.adj-actions button {
  flex: 1;
  margin: 0;
}

.adj-remove {
  color: var(--red);
  border-color: var(--red);
}

.coach {
  background: var(--primary-soft);
}

.coach-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.coach-name-next {
  margin-top: 24rpx;
}

.coach-text {
  font-size: 32rpx;
  line-height: 1.8;
}

.actions {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}
