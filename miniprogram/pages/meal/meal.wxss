.gain-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(90deg, #fff4e0 0%, #ffffff 80%);
}

.gain-icon {
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
}

.gain-body {
  flex: 1;
  margin-left: 16rpx;
}

.gain-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #d97a1e;
}

.gain-hint {
  font-size: 28rpx;
}

.arrival-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(90deg, #fff4e0 0%, #ffffff 80%);
}

.arrival-image {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.arrival-body {
  flex: 1;
  margin-left: 16rpx;
}

.arrival-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #b8763a;
}

.arrival-link {
  font-size: 28rpx;
  color: var(--primary);
  margin-top: 6rpx;
}

.hero-photo {
  width: 100%;
  height: 520rpx;
  border-radius: 24rpx;
  display: block;
  margin-bottom: 24rpx;
}

.big-kcal {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary);
  margin-top: 12rpx;
}

.error-box {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--yellow-soft);
  color: var(--yellow);
  font-size: 30rpx;
}

.note-line {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.portion {
  margin-left: 12rpx;
}

.coach {
  background: var(--primary-soft);
}

.coach-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.coach-name-next {
  margin-top: 24rpx;
}

.coach-text {
  font-size: 32rpx;
  line-height: 1.8;
}

.actions {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}
