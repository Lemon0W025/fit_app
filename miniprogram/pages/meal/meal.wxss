.gain-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(90deg, #fff4e0 0%, #ffffff 80%);
}

.gain-icon {
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
}

.gain-body {
  flex: 1;
  margin-left: 16rpx;
}

.gain-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--orange);
}

.gain-hint {
  font-size: 28rpx;
}

.gain-bonus {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--amber);
}

.arrival-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(90deg, #fff4e0 0%, #ffffff 80%);
}

.arrival-image {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.arrival-body {
  flex: 1;
  margin-left: 16rpx;
}

.arrival-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--orange);
}

.arrival-link {
  font-size: 28rpx;
  color: var(--primary);
  margin-top: 6rpx;
}

.hero-photo {
  width: 100%;
  height: 520rpx;
  border-radius: 24rpx;
  display: block;
  margin-bottom: 24rpx;
}

.big-kcal {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary);
  margin-top: 12rpx;
}

.error-box {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--yellow-soft);
  color: var(--amber);
  font-size: 30rpx;
}

.note-line {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.adjusted-note {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--amber);
}

/* 一起吃的：大概的范围 */
.range-note {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--muted);
}

/* 吃了哪些：一道菜一行，整行能点 */
.dish-hint {
  margin: -8rpx 0 8rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.dish {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  margin: 0 -16rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  border-bottom: 2rpx solid var(--line);
  transition: transform 150ms, background-color 150ms;
}

.dish:last-child {
  border-bottom: none;
}

.dish-press {
  transform: scale(0.98);
  background-color: var(--gray-soft);
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 34rpx;
}

.dish-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--yellow-soft);
  color: var(--amber);
  font-size: 26rpx;
}

/* 小暖没看清的 */
.dish-tag-unsure {
  background: #fde9e4;
  color: #c2452f;
}

.unsure-note {
  margin: 4rpx 0 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fde9e4;
  color: #a33a27;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 一次点掉几道没吃的：左边一个圈，点了打叉、整行变淡 */
.dish-check {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-right: 20rpx;
  border: 4rpx solid var(--gray);
  border-radius: 50%;
  text-align: center;
  line-height: 46rpx;
  font-size: 30rpx;
  color: #fff;
  transition: background-color 150ms, border-color 150ms;
}

.dish-check-on {
  border-color: #c2452f;
  background: #c2452f;
}

.dish-off .dish-main,
.dish-off .dish-kcal {
  opacity: 0.45;
  text-decoration: line-through;
}

.pick-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.pick-bar button {
  margin: 0;
}

button.btn-plain.pick-cancel {
  flex: 1;
  width: auto !important;
}

button.btn-primary.pick-ok {
  flex: 2;
  width: auto !important;
}

.how {
  margin-top: 12rpx;
  padding-top: 20rpx;
}

.how-gap {
  margin-top: 24rpx;
}

.skip-link {
  margin-top: 28rpx;
  padding: 12rpx 0;
  font-size: 30rpx;
  color: var(--primary);
}

.dish-sub {
  margin-top: 4rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.dish-kcal {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 32rpx;
  color: var(--muted);
}

.dish-go {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 40rpx;
  color: var(--gray);
}

/* 几个人一起吃 */
.people {
  margin: 4rpx 0 12rpx;
  padding: 16rpx 0 20rpx;
  border-bottom: 2rpx solid var(--line);
}

.people-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* 改份量的抽屉 */
.adj-preview {
  margin-top: 8rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
}

.adj-chips {
  flex-wrap: nowrap;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 4rpx;
}

/* 五个快捷按钮排一行 */
.adj-chips .chip {
  flex: 1 1 auto;
  padding: 16rpx 0;
  text-align: center;
  white-space: nowrap;
}

.adj-parts-title {
  margin: 24rpx 0 12rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.adj-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.adj-actions button {
  flex: 1;
  margin: 0;
}

.adj-remove {
  color: var(--red-text);
  border-color: var(--red);
}

.coach {
  background: var(--primary-soft);
}

.coach-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.coach-name-next {
  margin-top: 24rpx;
}

.coach-text {
  font-size: 32rpx;
  line-height: 1.8;
}

.actions {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

/* 亲友看板：亲友给这顿点的赞 */
.likes-line {
  margin: -8rpx 8rpx 24rpx;
  font-size: 30rpx;
  color: var(--red-text);
}
