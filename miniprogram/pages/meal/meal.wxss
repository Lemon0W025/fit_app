.gain-banner {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.gain-icon {
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
}

.gain-body {
  flex: 1;
  margin-left: 16rpx;
}

.gain-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--bean-ink);
}

.gain-hint {
  font-size: 28rpx;
}

.gain-bonus {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gold-ink);
}

.arrival-banner {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.arrival-image {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.arrival-body {
  flex: 1;
  margin-left: 16rpx;
}

.arrival-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gold-ink);
}

.arrival-link {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-top: 6rpx;
}

.arrival-go {
  width: 32rpx;
  height: 32rpx;
  margin-left: 4rpx;
}

.hero-photo {
  width: 100%;
  height: 540rpx;
  border-radius: 40rpx;
  display: block;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

/* 这一顿多少千卡：柠檬绿卡（.card-lime） */
.kcal-card .meal-time {
  margin-left: 16rpx;
  font-weight: 400;
}

.kcal-badge {
  background: #fff;
}

.big-kcal {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
}

.big-kcal .num {
  font-size: 128rpx;
}

.big-kcal-pre {
  margin-right: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.big-kcal-text {
  font-size: 56rpx;
  font-weight: 800;
}

.kcal-card .macro {
  background: rgba(255, 255, 255, 0.8);
}

.kcal-card .adjusted-note {
  color: var(--lime-ink);
}

.error-box {
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: var(--yellow-soft);
  color: var(--yellow);
  font-size: 30rpx;
}

.note-line {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.adjusted-note {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--yellow);
}

/* 吃了哪些：一道菜一行，整行能点 */
.dish-hint {
  margin: -4rpx 0 8rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.dish {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  margin: 0 -16rpx;
  padding: 12rpx 16rpx;
  border-radius: 24rpx;
  border-bottom: 2rpx solid var(--line);
  transition: transform 150ms, background-color 150ms;
}

.dish:last-child {
  border-bottom: none;
}

.dish-press {
  transform: scale(0.98);
  background-color: var(--chip);
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 600;
}

.dish-tag {
  margin-left: 12rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: var(--yellow-soft);
  color: var(--yellow);
  font-size: 26rpx;
}

.dish-sub {
  margin-top: 4rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.dish-kcal {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-family: var(--font-num);
  font-size: 34rpx;
  font-weight: 800;
}

.dish-go {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-left: 8rpx;
}

/* 几个人一起吃 */
.people {
  margin: 4rpx 0 12rpx;
  padding: 16rpx 0 20rpx;
  border-bottom: 2rpx solid var(--line);
}

.people-title {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.people-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

/* 改份量的抽屉 */
.adj-preview {
  margin-top: 8rpx;
  text-align: center;
  font-family: var(--font-num);
  font-size: 48rpx;
  font-weight: 800;
}

.adj-chips {
  flex-wrap: nowrap;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 4rpx;
}

/* 五个快捷按钮排一行 */
.adj-chips .chip {
  flex: 1 1 auto;
  padding: 16rpx 0;
  text-align: center;
  white-space: nowrap;
}

.adj-parts-title {
  margin: 24rpx 0 12rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.adj-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.adj-actions button {
  flex: 1;
  margin: 0;
}

.adj-remove {
  color: var(--red) !important;
  background: var(--red-soft) !important;
}

/* 小暖说：白卡；下一餐建议是一块浅灰圆角 */
.coach-next {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: var(--chip);
}

.coach-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--muted);
  margin-bottom: 4rpx;
}

.coach-text {
  font-size: 32rpx;
  line-height: 1.8;
}

.actions {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}
