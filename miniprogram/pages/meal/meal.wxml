<view wx:if="{{loading}}" class="empty">加载中…</view>

<view class="page {{fxSkip ? 'fx-skip' : ''}}" wx:if="{{meal}}" bindtap="skipFx">
  <view wx:if="{{gain}}" class="card gain-banner fx-rise" hover-class="fx-press" bindtap="goCamp">
    <image class="gain-icon fx-pop fx-d3" src="/images/garden/ui/bean.png" mode="aspectFit" />
    <view class="gain-body">
      <view class="gain-title">{{gain.title}}</view>
      <view wx:if="{{gain.bonus}}" class="gain-bonus">{{gain.bonus}}</view>
      <view class="stamps">
        <view wx:for="{{gain.stamps}}" wx:key="key" class="stamp {{item.cls}}">{{item.label}}</view>
      </view>
      <view class="gain-hint">{{gain.hint}}</view>
    </view>
  </view>
  <view wx:if="{{arrival}}" class="card arrival-banner fx-rise fx-d6" hover-class="fx-press" bindtap="goCamp">
    <image class="arrival-image" src="{{arrival.image}}" mode="aspectFit" />
    <view class="arrival-body">
      <view class="arrival-title">{{arrival.text}}</view>
      <view class="arrival-link">去营地看看 ›</view>
    </view>
  </view>

  <image wx:if="{{meal.fileID}}" class="hero-photo fx-rise fx-d1" src="{{meal.fileID}}" mode="aspectFill" bindtap="previewPhoto" />

  <view class="card fx-rise fx-d2">
    <view class="meal-head">
      <text class="meal-label">{{meal.label}}</text>
      <text class="meal-time">{{meal.timeText}}</text>
      <text wx:if="{{meal.ratingText}}" class="badge badge-{{meal.ratingClass}}">{{meal.ratingText}}</text>
    </view>

    <block wx:if="{{meal.status === 'done'}}">
      <view class="big-kcal">{{meal.kcalText}}</view>
      <view wx:if="{{meal.mode === 'text'}}" class="muted small">（根据文字描述估算）</view>
      <view wx:if="{{meal.adjustedText}}" class="adjusted-note">{{meal.adjustedText}}</view>
      <view wx:if="{{meal.analysis.isFood}}" class="macros">
        <view class="macro">
          <view class="macro-num">{{meal.analysis.protein}}g</view>
          <view class="macro-label">蛋白质</view>
        </view>
        <view class="macro">
          <view class="macro-num">{{meal.analysis.carbs}}g</view>
          <view class="macro-label">碳水</view>
        </view>
        <view class="macro">
          <view class="macro-num">{{meal.analysis.fat}}g</view>
          <view class="macro-label">脂肪</view>
        </view>
      </view>
    </block>
    <view wx:else class="error-box">{{meal.error}}</view>

    <view wx:if="{{meal.note}}" class="note-line">我的备注：{{meal.note}}</view>
  </view>

  <!-- 每道菜一行，点了弹抽屉拖滑杆改份量 -->
  <view wx:if="{{meal.dishes.length}}" class="card fx-rise fx-d3">
    <view class="card-title">吃了哪些</view>
    <view class="dish-hint">估得不对？点一道菜，拖一拖改份量</view>
    <view wx:for="{{meal.dishes}}" wx:key="index" class="dish" hover-class="dish-press" hover-stay-time="100" data-index="{{item.index}}" bindtap="openDish">
      <view class="dish-main">
        <view class="dish-name">{{item.name}}<text wx:if="{{item.adjusted}}" class="dish-tag">改过</text></view>
        <view wx:if="{{item.sub}}" class="dish-sub">{{item.sub}}</view>
      </view>
      <text class="dish-kcal">{{item.kcalText}}</text>
      <text class="dish-go">›</text>
    </view>
  </view>

  <view wx:if="{{meal.analysis}}" class="card coach fx-rise fx-d4">
    <view class="coach-name">🌿 小暖说</view>
    <view class="coach-text">{{meal.analysis.comment}}</view>
    <block wx:if="{{meal.analysis.suggestion}}">
      <view class="coach-name coach-name-next">下一餐建议</view>
      <view class="coach-text">{{meal.analysis.suggestion}}</view>
    </block>
  </view>

  <view wx:if="{{meal.status === 'failed' || editing}}" class="card">
    <view class="card-title">{{meal.status === 'failed' ? '补充一下描述，帮小暖认清楚' : '估得不准？补充描述后重新分析'}}</view>
    <textarea class="note" value="{{note}}" bindinput="onNote" maxlength="200" auto-height placeholder="比如：一碗米饭、半盘青椒肉丝，汤没喝" />
    <button class="btn-primary" bindtap="reanalyze" disabled="{{working}}">重新分析</button>
  </view>

  <view class="actions">
    <text wx:if="{{meal.status === 'done' && !editing}}" class="link" bindtap="startEdit">估得不准？</text>
    <text class="link link-danger" bindtap="remove">删除这条打卡</text>
  </view>

  <button class="btn-plain" bindtap="goCamp">回到营地</button>

  <sheet show="{{adjustShow}}" title="{{adjust.title}}" bindclose="closeAdjust">
    <view wx:if="{{adjust}}" class="adj">
      <view class="adj-preview">{{adjust.preview}}</view>
      <slider-bar min="{{adjust.min}}" max="{{adjust.max}}" step="{{adjust.step}}" value="{{adjust.value}}" unit="{{adjust.unit}}" prefix="{{adjust.prefix}}" bindchanging="onPortionSliding" bindchange="onPortionSlide" />
      <view class="chips adj-chips">
        <view wx:for="{{adjust.chips}}" wx:key="label" class="chip {{item.value === adjust.value ? 'chip-on' : ''}}" hover-class="chip-press" hover-stay-time="100" data-value="{{item.value}}" bindtap="pickPortion">{{item.label}}</view>
      </view>
      <view class="adj-actions">
        <button class="btn-plain adj-remove" bindtap="removeDish" disabled="{{working}}">这道没吃</button>
        <button class="btn-primary adj-save" bindtap="saveAdjust" disabled="{{working}}">就这么多</button>
      </view>
    </view>
  </sheet>

  <celebrate wx:if="{{celebrate}}" mode="{{celebrate}}" milestone="{{milestone}}" bindclose="onCelebrateClose" />
</view>
