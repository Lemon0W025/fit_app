.intro {
  margin: 8rpx 0 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 40rpx;
  background: var(--ink);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.6;
}

.text {
  font-size: 30rpx;
  line-height: 1.6;
}

.times {
  display: flex;
  justify-content: space-between;
  margin: 8rpx 0 4rpx;
}

.time {
  flex: 1;
  margin: 0 8rpx;
  padding: 20rpx 0 18rpx;
  border-radius: 28rpx;
  background: var(--lime-wash);
  text-align: center;
}

.time-word {
  font-size: 28rpx;
  color: var(--muted);
}

.time-at {
  margin: 4rpx 0;
  font-size: 56rpx;
}

.time-window {
  font-size: 26rpx;
  color: var(--muted);
}

.times-tip {
  margin-top: 12rpx;
  text-align: center;
}

.done {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--lime-ink);
}

.warn {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  background: var(--yellow-soft);
  color: var(--yellow);
  font-size: 28rpx;
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: center;
}

.row-text {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}

.row-title {
  margin-bottom: 12rpx;
}

.credits {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--lime-soft);
  color: var(--lime-ink);
  font-size: 30rpx;
  font-weight: 700;
}

.help {
  margin-top: 16rpx;
  line-height: 1.6;
}

.later {
  display: block;
  text-align: center;
}
