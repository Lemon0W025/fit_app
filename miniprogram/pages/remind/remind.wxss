.intro {
  margin: 8rpx 8rpx 24rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--primary);
}

.text {
  font-size: 30rpx;
  line-height: 1.6;
}

.times {
  display: flex;
  justify-content: space-between;
  margin: 8rpx 0 4rpx;
}

.time {
  flex: 1;
  text-align: center;
}

.time-word {
  font-size: 28rpx;
  color: var(--muted);
}

.time-at {
  margin: 4rpx 0;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
}

.time-window {
  font-size: 26rpx;
  color: var(--muted);
}

.times-tip {
  margin-top: 12rpx;
  text-align: center;
}

.done {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: var(--green-text);
}

.warn {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--yellow-soft);
  color: var(--amber);
  font-size: 28rpx;
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: center;
}

.row-text {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}

.row-title {
  margin-bottom: 4rpx;
}

.credits {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: var(--green-text);
}

.help {
  margin-top: 16rpx;
  line-height: 1.6;
}

.when {
  margin-top: 16rpx;
  line-height: 1.6;
}

.remind-status {
  margin-top: 8rpx;
}

.test-btn {
  margin-top: 20rpx;
}

.later {
  display: block;
  text-align: center;
}

/* 手机闹钟：一顿一行，右边一个小按钮（一次点击只能加一个） */
.cal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.cal-word {
  flex: 1;
  font-size: 32rpx;
  color: var(--text);
}

.cal-done {
  margin-top: 0;
}

button.btn-plain.cal-btn {
  flex: none;
  width: 240rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  font-size: 30rpx;
  line-height: 76rpx;
}

/* 「收不到提醒？」：排查的几条和试发按钮，平时收着 */
.trouble-link {
  display: block;
  margin-top: 20rpx;
}

.trouble {
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--bg);
}

.trouble-line {
  line-height: 1.7;
}
