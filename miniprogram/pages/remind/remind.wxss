.intro {
  margin: 8rpx 8rpx 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.6;
  color: var(--brand);
}

.text {
  font-size: 30rpx;
  line-height: 1.6;
}

.times {
  display: flex;
  justify-content: space-between;
  margin: 8rpx 0 4rpx;
}

.time {
  flex: 1;
  text-align: center;
}

.time-word {
  font-size: 28rpx;
  color: var(--muted);
}

.time-at {
  margin: 4rpx 0;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--brand);
}

.time-window {
  font-size: 26rpx;
  color: var(--muted);
}

.times-tip {
  margin-top: 12rpx;
  text-align: center;
}

.done {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}

.warn {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--yellow-soft);
  color: var(--yellow);
  font-size: 28rpx;
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: center;
}

.row-text {
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}

.row-title {
  margin-bottom: 4rpx;
}

.credits {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand);
}

.help {
  margin-top: 16rpx;
  line-height: 1.6;
}

.later {
  display: block;
  text-align: center;
}
