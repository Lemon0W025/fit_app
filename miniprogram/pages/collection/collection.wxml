<view wx:if="{{!loaded}}" class="empty">翻开图鉴…</view>

<view class="page" wx:if="{{loaded}}">
  <view class="card progress-card">
    <image class="book" src="/images/garden/ui/book.png" mode="aspectFit" />
    <view class="progress-body">
      <view class="progress-title">已收集 {{collectedCount}} / {{totalCount}}</view>
      <view class="bar"><view class="bar-fill" style="width: {{percent}}%"></view></view>
      <view class="muted small">集齐 20 种，庭院会扩大成 8×8</view>
    </view>
  </view>

  <view wx:for="{{groups}}" wx:key="id" wx:for-item="group" class="card">
    <view class="group-head">
      <text class="group-title" style="color: {{group.color}}">{{group.label}}</text>
      <text class="muted small">{{group.collectedCount}} / {{group.items.length}}</text>
    </view>
    <view class="grid">
      <view wx:for="{{group.items}}" wx:key="id" class="cell">
        <image class="cell-image {{item.collected ? '' : 'locked'}}" src="{{item.image}}" mode="aspectFit" />
        <view class="cell-name">{{item.collected ? item.name : '？？？'}}</view>
        <view wx:if="{{item.termName}}" class="cell-term">{{item.termName}}限定</view>
      </view>
    </view>
  </view>

  <button class="btn-primary btn-big" bindtap="goGacha">去扭蛋</button>
</view>
