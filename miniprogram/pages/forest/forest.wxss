.today-card {
  text-align: center;
  background: linear-gradient(180deg, #fff4e0 0%, #ffffff 70%);
}

.today-stamps {
  justify-content: center;
  margin: 16rpx 0;
}

.today-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
}

.today-hint {
  font-size: 30rpx;
  margin-top: 8rpx;
}

.today-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx 32rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--muted);
}

/* 一条放不下就整条换行，别在字中间断开 */
.today-stat {
  white-space: nowrap;
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.month-label {
  font-size: 32rpx;
  font-weight: 700;
}

.month-arrow {
  font-size: 48rpx;
  color: var(--primary);
  padding: 0 24rpx;
  line-height: 1;
}

.month-arrow-off {
  color: var(--line);
}

.weekdays,
.grid {
  display: flex;
  flex-wrap: wrap;
}

.weekday {
  width: calc(100% / 7);
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

.cell {
  width: calc(100% / 7);
  text-align: center;
  margin-top: 8rpx;
}

.cell-day {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.cell-future {
  opacity: 0.35;
}

.cell-beans {
  font-size: 20rpx;
  color: #d97a1e;
  min-height: 28rpx;
  line-height: 28rpx;
}

.month-stats {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
  text-align: center;
  font-size: 28rpx;
  color: var(--muted);
}

/* 纪念章一排：横着能滑 */
.medals {
  white-space: nowrap;
  margin-top: 24rpx;
}

.medal-cell {
  display: inline-block;
  width: 140rpx;
  vertical-align: top;
  text-align: center;
  transition: transform 0.15s, opacity 0.15s;
}

.medal-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #b8763a;
}

.medal-label-off {
  color: var(--gray);
}

/* 今天那一格 */
.cell-today {
  border-radius: 16rpx;
  background: var(--primary-soft);
  box-shadow: inset 0 0 0 3rpx rgba(78, 125, 91, 0.35);
}
