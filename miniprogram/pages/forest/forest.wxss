/* 今天：奖励卡（金色奶油底 + 金边） */
.today-card {
  text-align: center;
}

.today-stamps {
  justify-content: center;
  margin: 16rpx 0;
}

.today-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--bean-ink);
}

.today-hint {
  font-size: 30rpx;
  margin-top: 8rpx;
}

.today-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx 32rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--muted);
}

/* 一条放不下就整条换行，别在字中间断开 */
.today-stat {
  white-space: nowrap;
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.month-label {
  font-size: 36rpx;
  font-weight: 800;
}

.month-arrow {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--chip);
  font-size: 44rpx;
  line-height: 64rpx;
  text-align: center;
  color: var(--ink);
}

.month-arrow-off {
  color: #c9ccd0;
}

.weekdays,
.grid {
  display: flex;
  flex-wrap: wrap;
}

.weekday {
  width: calc(100% / 7);
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
}

.cell {
  width: calc(100% / 7);
  text-align: center;
  margin-top: 8rpx;
}

.cell-day {
  font-family: var(--font-num);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.cell-future {
  opacity: 0.35;
}

.cell-beans {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--gold-ink);
  min-height: 28rpx;
  line-height: 28rpx;
}

.month-stats {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
  text-align: center;
  font-size: 28rpx;
  color: var(--muted);
}

/* 纪念章一排：横着能滑 */
.medals {
  white-space: nowrap;
  margin-top: 24rpx;
}

.medal-cell {
  display: inline-block;
  width: 140rpx;
  vertical-align: top;
  text-align: center;
  transition: transform 0.15s, opacity 0.15s;
}

.medal-label {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--bean-ink);
}

.medal-label-off {
  color: var(--gray-text);
}

/* 今天那一格 */
/* 今天那一格：柠檬绿圆角块 */
.cell-today {
  border-radius: 20rpx;
  background: var(--lime-soft);
}

/* 每周小结的入口：和「我的」里那几行一个样（图标小圆章 + 两行字 + 箭头） */
.week-entry {
  display: flex;
  align-items: center;
}

.week-entry .chip-icon {
  flex-shrink: 0;
  margin-right: 20rpx;
}

.week-entry-body {
  flex: 1;
  min-width: 0;
}

.week-entry-title {
  font-size: 34rpx;
  font-weight: 700;
}

.week-entry-arrow {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
}
