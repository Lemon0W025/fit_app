<view wx:if="{{!loaded}}" class="empty">正在走进森林…</view>

<view class="page" wx:if="{{loaded}}">
  <view class="card today-tree">
    <view class="today-title">{{today.title}}</view>
    <image class="today-image" src="{{today.image}}" mode="aspectFit" />
    <view class="today-hint">{{today.hintText}}</view>
    <view class="today-stats">
      <text wx:if="{{today.streakText}}" class="today-stat">{{today.streakText}}</text>
      <text class="today-stat">🌳 累计种了 {{view.totalTrees}} 棵</text>
      <text wx:if="{{today.beansText}}" class="today-stat">🫘 {{today.beansText}}</text>
    </view>
  </view>

  <view class="card">
    <view class="month-bar">
      <text class="month-arrow" bindtap="prevMonth">‹</text>
      <text class="month-label">{{view.monthLabel}}的森林</text>
      <text class="month-arrow {{view.nextMonth ? '' : 'month-arrow-off'}}" bindtap="nextMonth">›</text>
    </view>
    <view class="weekdays">
      <text wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</text>
    </view>
    <view class="grid">
      <view wx:for="{{cells}}" wx:key="key" class="cell" data-key="{{item.key}}" bindtap="openDay">
        <block wx:if="{{!item.blank}}">
          <image wx:if="{{item.image}}" class="cell-image" src="{{item.image}}" mode="aspectFit" />
          <view wx:else class="cell-image cell-future"></view>
          <view class="cell-day">{{item.day}}</view>
        </block>
      </view>
    </view>
    <view class="month-stats">这个月种了 {{view.stats.trees}} 棵树，其中 {{view.stats.fruits}} 棵结了果</view>
  </view>
</view>
