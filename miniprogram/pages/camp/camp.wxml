<view class="screen">
  <view wx:if="{{!loaded}}" class="loading">正在走进营地…</view>

  <movable-area wx:if="{{loaded}}" class="map-area {{world.night ? 'night' : ''}}">
    <movable-view class="map" direction="all" inertia out-of-bounds="{{false}}" scale scale-min="{{world.minScale}}" scale-max="{{world.maxScale}}" scale-value="{{view.scale}}" x="{{view.x}}" y="{{view.y}}" bindscale="onZoom" style="width: {{world.worldWidth}}px; height: {{world.worldHeight}}px">
      <image class="backdrop" src="{{backdrop}}" mode="scaleToFill" style="width: {{world.worldWidth}}px; height: {{world.worldHeight}}px" />
      <view id="world" class="world" style="top: {{world.top}}px; width: {{world.width}}px; height: {{world.height}}px">
        <image wx:for="{{base}}" wx:key="key" class="base" src="{{item.image}}" binderror="onBaseError" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px" />
        <view wx:for="{{cuts}}" wx:key="key" class="cut" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px; z-index: {{item.z}}">
          <image class="cut-img" src="{{item.image}}" webp="{{true}}" mode="scaleToFill" binderror="onCutError" style="left: {{item.imgLeft}}px; width: {{item.imgWidth}}px; height: {{item.height}}px" />
        </view>
        <block wx:for="{{fx}}" wx:key="key">
          <view wx:if="{{item.kind === 'fire'}}" class="fx-fire" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px; z-index: {{item.z}}">
            <image class="fx-fire-strip" src="{{item.image}}" mode="scaleToFill" binderror="onCutError" style="width: {{item.strip.width}}%; height: {{item.strip.height}}%; left: {{item.strip.left}}%; top: {{item.strip.top}}%; animation-duration: {{item.ms}}ms" />
          </view>
          <image wx:elif="{{item.kind === 'patch'}}" class="fx-patch" src="{{item.image}}" mode="scaleToFill" binderror="onCutError" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px; z-index: {{item.z}}" />
          <image wx:elif="{{item.kind === 'wisp'}}" class="fx-wisp" src="{{item.image}}" mode="scaleToFill" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px; z-index: {{item.z}}; animation-delay: -{{item.delay}}s; animation-duration: {{item.ms}}ms" />
          <view wx:else class="fx-{{item.kind}} {{item.variant ? 'fx-' + item.variant : ''}}" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px; z-index: {{item.z}}; animation-delay: -{{item.delay}}s"></view>
        </block>
        <block wx:for="{{decor}}" wx:key="uid">
          <image class="decor {{mode === 'view' ? '' : 'ghosted'}}" src="{{item.image}}" mode="scaleToFill" binderror="onDecorError" data-uid="{{item.uid}}" catchtap="tapDecor" bindlongpress="liftDecor" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px; z-index: {{item.z}}; filter: {{item.light || 'none'}}" />
          <image wx:if="{{item.night && item.moon}}" class="decor decor-moon {{mode === 'view' ? '' : 'ghosted'}}" src="{{item.image}}" mode="scaleToFill" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px; z-index: {{item.z}}; filter: {{item.moonLight}}; opacity: {{mode === 'view' ? item.moon : item.moon * 0.6}}" />
          <!-- 秋千的座位、吊床的布那层：有小家伙在上面就摆（swayOn 是摆的动画类，和它同一次 setData 开始，一起摆） -->
          <block wx:if="{{item.seat}}">
            <image class="decor decor-seat {{swayOn[item.uid] || ''}} {{mode === 'view' ? '' : 'ghosted'}}" src="{{item.seat.image}}" mode="scaleToFill" binderror="onDecorError" data-uid="{{item.uid}}" catchtap="tapDecor" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px; z-index: {{item.z + 1}}; filter: {{item.light || 'none'}}; transform-origin: {{item.seat.ox}}px {{item.seat.oy}}px" />
            <image wx:if="{{item.night && item.moon}}" class="decor decor-moon decor-seat {{swayOn[item.uid] || ''}} {{mode === 'view' ? '' : 'ghosted'}}" src="{{item.seat.image}}" mode="scaleToFill" data-uid="{{item.uid}}" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px; z-index: {{item.z + 1}}; filter: {{item.moonLight}}; opacity: {{mode === 'view' ? item.moon : item.moon * 0.6}}; transform-origin: {{item.seat.ox}}px {{item.seat.oy}}px" />
          </block>
        </block>
        <view wx:if="{{potHit}}" class="pot-hit" catchtap="tapPot" style="left: {{potHit.left}}px; top: {{potHit.top}}px; width: {{potHit.width}}px; height: {{potHit.height}}px; z-index: {{potHit.z}}"></view>
        <block wx:for="{{pets}}" wx:key="id">
          <view wx:if="{{!item.hidden}}" class="shadow" style="transform: translate3d({{item.shadow.left}}px, {{0 - item.shadow.bottom}}px, 0); width: {{item.shadow.width}}px; height: {{item.shadow.height}}px; z-index: {{item.z - 1}}; transition-duration: {{item.duration}}ms"></view>
          <view wx:if="{{!item.hidden}}" class="pet {{mode === 'view' ? '' : 'ghosted'}}" style="transform: translate3d({{item.left}}px, {{0 - item.bottom}}px, 0); width: {{item.width}}px; z-index: {{item.z}}; transition-duration: {{item.duration}}ms" data-index="{{index}}" catchtap="tapPet" bindlongpress="pressPet">
            <view wx:if="{{item.bubble}}" class="bubble" style="width: {{item.bubbleWidth}}px; left: {{item.bubbleLeft}}px; bottom: {{item.bubbleBottom}}px">{{item.bubble}}</view>
            <view wx:if="{{item.emoji}}" class="act-emoji">{{item.emoji}}</view>
            <image wx:if="{{item.tapping}}" class="heart" src="/images/garden/fx/heart.png" mode="aspectFit" />
            <view class="pet-sway {{item.sway ? item.sway.cls : ''}}" style="transform-origin: {{item.sway ? item.sway.ox + 'px ' + item.sway.oy + 'px' : '50% 100%'}}">
            <view class="pet-body {{item.flip ? 'flip' : ''}}" style="height: {{item.width}}px">
              <view wx:if="{{item.sheet}}" class="anim-frame" style="width: {{item.width}}px; height: {{item.width}}px">
                <image class="anim-strip anim-f{{item.anim.frames}}" src="{{item.sheet}}" mode="scaleToFill" binderror="onAnimError" data-id="{{item.id}}" style="width: {{item.anim.cols * 100}}%; height: {{item.anim.rows * 100}}%; margin-left: 0; margin-top: -{{item.anim.row * 100}}%; animation-duration: {{item.anim.ms}}ms; filter: {{item.light || 'none'}}; transition: filter {{item.duration}}ms linear" />
                <image wx:if="{{item.night}}" class="anim-strip anim-f{{item.anim.frames}} moon" src="{{item.sheet}}" mode="scaleToFill" style="width: {{item.anim.cols * 100}}%; height: {{item.anim.rows * 100}}%; margin-left: 0; margin-top: -{{item.anim.row * 100}}%; animation-duration: {{item.anim.ms}}ms; filter: {{item.moonLight}}; opacity: {{item.moon}}; transition: filter {{item.duration}}ms linear, opacity {{item.duration}}ms linear" />
              </view>
              <block wx:else>
                <image class="pet-img {{item.cssAction}} gait-{{item.action === 'walk' || item.action === 'fly' || item.action === 'gift' ? 'on' : 'off'}}" src="{{item.image}}" mode="widthFix" style="filter: {{item.light || 'none'}}; transition: filter {{item.duration}}ms linear" />
                <image wx:if="{{item.night}}" class="pet-img moon {{item.cssAction}} gait-{{item.action === 'walk' || item.action === 'fly' || item.action === 'gift' ? 'on' : 'off'}}" src="{{item.image}}" mode="widthFix" style="filter: {{item.moonLight}}; opacity: {{item.moon}}; transition: filter {{item.duration}}ms linear, opacity {{item.duration}}ms linear" />
              </block>
            </view>
            </view>
          </view>
        </block>
      </view>
      <image wx:for="{{frame}}" wx:key="key" class="base frame-tile" src="{{item.image}}" binderror="onBaseError" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px" />
      <view wx:if="{{lit}}" class="lit-layer {{litFade ? 'lit-fade' : ''}}" style="width: {{world.worldWidth}}px; height: {{world.worldHeight}}px">
        <image class="backdrop" src="{{lit.backdrop}}" mode="scaleToFill" style="width: {{world.worldWidth}}px; height: {{world.worldHeight}}px" />
        <image wx:for="{{lit.tiles}}" wx:key="key" class="base" src="{{item.image}}" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px" />
      </view>
      <view wx:if="{{tint}}" class="tint tint-{{tint}}"></view>
      <view wx:if="{{mode !== 'view'}}" class="drag-layer" style="top: {{world.top}}px; width: {{world.width}}px; height: {{world.height}}px" catchtouchstart="onDragStart" catchtouchmove="onDragMove" catchtouchend="onDragEnd" catchtouchcancel="onDragEnd">
        <view wx:if="{{drag && drag.foot}}" class="drag-foot {{drag.ok ? 'ok' : 'bad'}}" style="left: {{drag.foot.left}}px; top: {{drag.foot.top}}px; width: {{drag.foot.width}}px; height: {{drag.foot.height}}px"></view>
        <image wx:if="{{drag}}" class="drag-ghost {{drag.ok ? '' : 'bad'}}" src="{{drag.image}}" mode="scaleToFill" style="left: {{drag.left}}px; top: {{drag.top}}px; width: {{drag.width}}px; height: {{drag.height}}px" />
      </view>
    </movable-view>
  </movable-area>

  <block wx:if="{{loaded}}">
    <view class="hud-res" style="top: {{hud.top}}px; height: {{hud.height}}px">
      <image class="res-icon" src="/images/garden/ui/bean.png" mode="aspectFit" />
      <text class="res-num">{{beans}}</text>
    </view>
    <view wx:if="{{daily}}" class="hud-today" style="top: {{hud.below}}px">
      <text class="hud-today-text">{{daily.title}}</text>
      <view class="stamps stamps-mini">
        <view wx:for="{{daily.stamps}}" wx:key="key" class="stamp {{item.cls}}">{{item.label}}</view>
      </view>
    </view>
    <view class="hud-notes" style="top: {{hud.below + 50}}px">
      <view wx:if="{{termText}}" class="hud-note">🍂 {{termText}}</view>
      <view wx:if="{{peekText}}" class="hud-note hud-note-green">{{peekText}}</view>
      <view wx:if="{{giftReady}}" class="hud-note hud-note-gold">🎁 有小动物叼着礼物来了，点它收下</view>
    </view>

    <view wx:if="{{mode === 'view'}}" class="side side-left">
      <view class="side-btn" bindtap="goAlbum">
        <image class="side-icon" src="/images/garden/ui/book.png" mode="aspectFit" />
        <text class="side-label">图册</text>
      </view>
      <view class="side-btn" bindtap="goCalendar">
        <image class="side-icon" src="/images/garden/ui/calendar.png" mode="aspectFit" />
        <text class="side-label">日历</text>
      </view>
    </view>
    <view wx:if="{{mode === 'view'}}" class="side side-right">
      <view class="side-btn" bindtap="goGacha">
        <image class="side-icon" src="/images/garden/ui/gacha.png" mode="aspectFit" />
        <text class="side-label">扭蛋</text>
        <view wx:if="{{canSpin}}" class="dot"></view>
      </view>
      <view class="side-btn" bindtap="goShop">
        <image class="side-icon" src="/images/garden/ui/shop.png" mode="aspectFit" />
        <text class="side-label">商店</text>
      </view>
      <view class="side-btn" bindtap="openBag">
        <image class="side-icon" src="/images/garden/ui/bag.png" mode="aspectFit" />
        <text class="side-label">背包</text>
        <view wx:if="{{bagCount}}" class="badge">{{bagCount}}</view>
      </view>
      <view class="side-btn" bindtap="openResidents">
        <image class="side-icon" src="/images/garden/ui/paw.png" mode="aspectFit" />
        <text class="side-label">住户</text>
      </view>
    </view>

    <view wx:if="{{mode === 'view'}}" class="recenter" bindtap="recenter">
      <image class="recenter-icon" src="/images/garden/ui/campfire.png" mode="aspectFit" />
    </view>
    <view wx:if="{{mode === 'view'}}" class="checkin-btn" bindtap="goCheckin">
      <image class="checkin-icon" src="/images/garden/ui/camera.png" mode="aspectFit" />
      <text>拍一拍这一餐</text>
    </view>

    <view wx:if="{{mode !== 'view'}}" class="placing">
      <view class="placing-main">
        <view class="placing-text">{{mode === 'feed' ? '拿着「' + selectedName + '」：拖进锅里煮上，或者拖到小动物身上喂它' : (mode === 'place' ? '摆放' : '挪动') + '「' + selectedName + '」：拖到草地上松手'}}</view>
        <view wx:if="{{mode === 'feed' && selectedSmell.length}}" class="smell smell-wide">
          <text class="smell-label">今天闻着它会来</text>
          <view wx:for="{{selectedSmell}}" wx:for-item="pet" wx:key="id" class="smell-face"><image class="smell-img {{pet.known ? '' : 'smell-unknown'}}" src="{{pet.face}}" mode="aspectFit" /></view>
        </view>
      </view>
      <view class="placing-btns">
        <button class="btn-plain btn-small" bindtap="cancel">取消</button>
      </view>
    </view>

    <view wx:if="{{bagOpen}}" class="drawer-mask" catchtap="closeBag"></view>
    <view class="drawer {{bagOpen ? 'drawer-open' : ''}}">
      <view class="drawer-head">
        <view class="bag-tabs">
          <text class="bag-tab {{bagTab === 'food' ? 'on' : ''}}" data-tab="food" catchtap="switchBag">食物</text>
          <text class="bag-tab {{bagTab === 'decor' ? 'on' : ''}}" data-tab="decor" catchtap="switchBag">装饰</text>
        </view>
        <text class="drawer-close" catchtap="closeBag">✕</text>
      </view>
      <block wx:if="{{bagTab === 'food'}}">
        <scroll-view wx:if="{{foodBag.length}}" class="bag" scroll-x enhanced show-scrollbar="{{false}}">
          <view wx:for="{{foodBag}}" wx:key="id" class="bag-item" style="border-color: {{item.rarityColor}}" data-id="{{item.id}}" bindtap="pickFood">
            <image class="bag-image" src="{{item.image}}" mode="aspectFit" />
            <view class="bag-name">{{item.name}}</view>
            <view wx:if="{{item.count > 1}}" class="bag-count">×{{item.count}}</view>
            <view wx:if="{{item.smell.length}}" class="smell">
              <view wx:for="{{item.smell}}" wx:for-item="pet" wx:key="id" class="smell-face"><image class="smell-img {{pet.known ? '' : 'smell-unknown'}}" src="{{pet.face}}" mode="aspectFit" /></view>
            </view>
          </view>
        </scroll-view>
        <view wx:else class="muted small">没有吃的了，去扭蛋机抽一个吧～</view>
        <view class="muted small bag-hint">点一样拿在手里：拖进锅里煮上（下面是今天闻着它会来的小动物，黑影是还没来过的），或者拖到小动物身上喂它</view>
      </block>
      <block wx:else>
        <scroll-view wx:if="{{decorBag.length}}" class="bag" scroll-x enhanced show-scrollbar="{{false}}">
          <view wx:for="{{decorBag}}" wx:key="id" class="bag-item" data-id="{{item.id}}" bindtap="pickDecor">
            <image class="bag-image" src="{{item.image}}" mode="aspectFit" />
            <view class="bag-name">{{item.name}}</view>
            <view wx:if="{{item.count > 1}}" class="bag-count">×{{item.count}}</view>
          </view>
        </scroll-view>
        <view wx:else class="muted small">没有待摆的装饰，去商店挑一件吧～</view>
      </block>
    </view>

    <view wx:if="{{residentsOpen}}" class="drawer-mask" catchtap="closeResidents"></view>
    <view class="drawer {{residentsOpen ? 'drawer-open' : ''}}">
      <view class="drawer-head">
        <text class="drawer-title">住户（点一下，带你去找它）</text>
        <text class="drawer-close" catchtap="closeResidents">✕</text>
      </view>
      <view wx:if="{{residents.length}}" class="res-list">
        <view wx:for="{{residents}}" wx:key="id" class="res-row" data-index="{{item.index}}" bindtap="findResident">
          <image class="res-avatar" src="{{item.face}}" mode="aspectFit" />
          <view class="res-body">
            <view class="res-name">{{item.name}}</view>
            <view class="res-text">{{item.text}}</view>
          </view>
          <text class="res-go">去看看 ›</text>
        </view>
      </view>
      <view wx:else class="muted small">还没有小动物住进来。把食物放进锅里煮上，闻着香味来的小动物下次拍正餐就住下～</view>
    </view>
  </block>

  <view wx:if="{{welcome}}" class="overlay" catchtap="closeWelcome">
    <view class="welcome" catchtap="noop">
      <image class="welcome-gift" src="/images/garden/ui/gift.png" mode="aspectFit" />
      <view class="welcome-title">欢迎来到暖暖营地！</view>
      <view class="welcome-text">豆豆已经在篝火边等你了。送你 {{welcome.beans}} 暖豆：每天好好吃饭打卡攒暖豆，扭蛋抽食物放进锅里煮，爱吃的小动物闻着香味就来，下次拍正餐就住下；每次打卡都算喂它们一顿，越喂越亲～</view>
      <button class="btn-primary" bindtap="goGacha">去扭蛋</button>
      <view class="link link-muted welcome-later" bindtap="closeWelcome">先看看</view>
    </view>
  </view>
</view>
