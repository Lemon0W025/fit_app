/* ---------------------------------------------------------------- 全屏地图 */

page {
  height: 100%;
  overflow: hidden;
}

.screen {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #e8e0cf;
}

.loading {
  padding-top: 40vh;
  text-align: center;
  color: var(--muted);
}

/* 画始终盖满屏幕，这层底色只在图还没画出来的一瞬间露出来：和画的边一个颜色（白天草绿、夜里深蓝） */
.map-area {
  width: 100%;
  height: 100%;
  background: #a2cb47;
}

.map-area.night {
  background: #16435a;
}

.world {
  position: absolute;
  left: 0;
  top: 0;
}

@keyframes sway {
  0%,
  100% {
    transform: rotate(-3deg);
  }
  50% {
    transform: rotate(3deg);
  }
}

.hud-notes {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  z-index: 50;
  pointer-events: none;
}

.hud-note {
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  color: #b8763a;
  background: rgba(255, 244, 224, 0.95);
  border-radius: 16rpx;
}

.hud-note-green {
  color: var(--primary);
  background: rgba(238, 246, 234, 0.95);
}

.recenter {
  position: absolute;
  left: 24rpx;
  bottom: 52rpx;
  z-index: 50;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 30, 0.15);
}

.recenter-icon {
  width: 56rpx;
  height: 56rpx;
}

.badge {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #e8553b;
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
}

.placing {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  z-index: 55;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fffbe8;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(60, 50, 30, 0.16);
}

/* 拖动层：摆放 / 移动时盖住地图，幽灵图跟手指走，目标格亮绿或红 */
.drag-layer {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2500;
}

.drag-ghost {
  position: absolute;
  opacity: 0.92;
  pointer-events: none;
  transform: scale(1.08);
  transform-origin: 50% 100%;
  filter: drop-shadow(0 14rpx 12rpx rgba(40, 30, 10, 0.35));
}

.drag-ghost.flip {
  transform: scale(1.08) scaleX(-1);
}

.drag-ghost.bad {
  opacity: 0.6;
  filter: grayscale(0.5) drop-shadow(0 14rpx 12rpx rgba(40, 30, 10, 0.35));
}

.placing-main {
  flex: 1;
}

.placing-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #8a6a1e;
}

/* 今天闻着这样食物会来的小动物：头像一排，没来过的压成黑影 */
.smell {
  display: flex;
  justify-content: center;
  margin-top: 6rpx;
}

.smell-wide {
  justify-content: flex-start;
  align-items: center;
  margin-top: 12rpx;
}

.smell-label {
  font-size: 26rpx;
  color: #8a6a1e;
  margin-right: 10rpx;
}

.smell-face {
  width: 42rpx;
  height: 42rpx;
  margin: 0 2rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
}

.smell-wide .smell-face {
  width: 56rpx;
  height: 56rpx;
  margin-right: 8rpx;
}

.smell-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 只把头像本身压黑（白底在外面那层），看得出是谁的轮廓 */
.smell-unknown {
  filter: brightness(0);
  opacity: 0.55;
}

button.btn-small {
  width: 140rpx !important;
  margin: 0 0 0 16rpx;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.bag {
  white-space: nowrap;
}

.bag-item {
  display: inline-block;
  position: relative;
  width: 150rpx;
  margin-right: 16rpx;
  padding: 12rpx 0 10rpx;
  text-align: center;
  border: 3rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--gray-soft);
  vertical-align: top;
}

.bag-image {
  width: 110rpx;
  height: 110rpx;
}

.bag-name {
  font-size: 24rpx;
  white-space: normal;
  line-height: 1.3;
  padding: 0 6rpx;
}

.bag-count {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #d97a1e;
}

.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(47, 42, 36, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.welcome {
  width: 78%;
  background: var(--card);
  border-radius: 32rpx;
  padding: 40rpx 40rpx 24rpx;
  text-align: center;
}

.welcome-gift {
  width: 220rpx;
  height: 220rpx;
  animation: gift-pop 0.6s ease-out;
}

@keyframes gift-pop {
  0% {
    transform: scale(0.3) rotate(-12deg);
  }
  70% {
    transform: scale(1.1) rotate(4deg);
  }
  100% {
    transform: scale(1) rotate(0);
  }
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--primary);
  margin: 12rpx 0;
}

.welcome-text {
  font-size: 30rpx;
  text-align: left;
  line-height: 1.7;
}

.welcome-later {
  display: block;
  margin-top: 4rpx;
}

/* 镜像放在外层，里面的图片还能做自己的动画 */
.flip {
  transform: scaleX(-1);
}

/* 逐帧动画：一张 6×4 的拼图，外框只露一格，里面的长条按帧数一格一格跳（steps），行、起始列用 margin 挪 */
.anim-frame {
  position: relative;
  overflow: hidden;
  transform-origin: 50% 100%;
  filter: drop-shadow(0 4rpx 3rpx rgba(60, 50, 30, 0.25));
}

.anim-strip {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  animation-iteration-count: infinite;
}

.anim-f6 {
  animation-name: strip6;
  animation-timing-function: steps(6);
}

.anim-f4 {
  animation-name: strip4;
  animation-timing-function: steps(4);
}

.anim-f2 {
  animation-name: strip2;
  animation-timing-function: steps(2);
}

@keyframes strip6 {
  to {
    transform: translateX(-100%);
  }
}

@keyframes strip4 {
  to {
    transform: translateX(-66.6667%);
  }
}

@keyframes strip2 {
  to {
    transform: translateX(-33.3333%);
  }
}

/* 放在各种动作后面：点一下的跳跃优先 */
.tap {
  animation: jump 0.6s ease-out;
}

.bubble {
  position: absolute;
  padding: 10rpx 20rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx;
  font-size: 32rpx;
  line-height: 1.4;
  color: #4a3f35;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 30, 0.18);
  z-index: 2;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.heart {
  position: absolute;
  left: 50%;
  top: -20%;
  width: 60rpx;
  height: 60rpx;
  animation: rise 0.9s ease-out forwards;
}

@keyframes rise {
  0% {
    transform: translate(-50%, 0) scale(0.6);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -80rpx) scale(1.2);
    opacity: 0;
  }
}

/* ---------------------------------------------------------------- 小岛 */

/* 左上角：游戏风的暖豆资源条 + 今天的暖豆和印章 */
.hud-res {
  position: absolute;
  left: 24rpx;
  z-index: 50;
  display: flex;
  align-items: center;
  min-width: 200rpx;
  padding: 0 28rpx 0 6rpx;
  box-sizing: border-box;
  border: 4rpx solid #ffffff;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #3577c0 0%, #1d4f8a 100%);
  box-shadow: 0 6rpx 0 rgba(20, 50, 90, 0.35);
}

.res-icon {
  width: 60rpx;
  height: 60rpx;
}

.res-num {
  flex: 1;
  text-align: center;
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
}

.hud-today {
  position: absolute;
  left: 24rpx;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
}

.hud-today-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #b8763a;
}

.stamps-mini {
  gap: 4rpx;
  margin: 0;
}

.stamps-mini .stamp {
  width: 36rpx;
  height: 36rpx;
  font-size: 20rpx;
}

.stamps-mini .stamp-on {
  box-shadow: 0 0 0 4rpx #f0b429;
}

.stamps-mini .stamp-on::after {
  display: none;
}

/* 左右两列圆按钮 */
.side {
  position: absolute;
  top: 36%;
  z-index: 50;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.side-left {
  left: 20rpx;
}

.side-right {
  right: 20rpx;
}

.side-btn {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  background: linear-gradient(180deg, #fff8ec 0%, #ffe9c7 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 0 rgba(150, 100, 40, 0.25);
}

.side-icon {
  width: 70rpx;
  height: 70rpx;
}

.side-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #8a4f1a;
  margin-top: -4rpx;
}

.dot {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #e8553b;
  border: 3rpx solid #ffffff;
}

/* 底部大打卡按钮 */
.checkin-btn {
  position: absolute;
  left: 50%;
  bottom: 36rpx;
  z-index: 50;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 26rpx 56rpx;
  border-radius: 60rpx;
  border: 5rpx solid #ffffff;
  background: linear-gradient(180deg, #6fcf5a 0%, #3e9a3a 100%);
  box-shadow: 0 8rpx 0 #2c6e2a;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  white-space: nowrap;
}

.checkin-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 10rpx;
}

/* 物件、小动物脚下的影子 */
/* ---------------------------------------------------------------- 营地里的东西（火苗、火光、火星、热气这些小动静的样式在文件末尾） */

.shadow {
  position: absolute;
  left: 0;
  bottom: 0;
  border-radius: 50%;
  /* 接触阴影：中间深、边上化开，像压在草上 */
  background: radial-gradient(ellipse at center, rgba(30, 40, 20, 0.42) 0%, rgba(30, 40, 20, 0.22) 45%, rgba(30, 40, 20, 0) 72%);
  pointer-events: none;
  /* 和宠物一样用 transform 挪（见 .pet） */
  transform: translate3d(0, 0, 0);
  transition-property: transform;
  transition-timing-function: linear;
  will-change: transform;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

.b1 { background: #f4b740; --dx: -120rpx; --dy: -200rpx; }

.b2 { background: #e8553b; --dx: 90rpx; --dy: -240rpx; animation-delay: 0.05s; }

.b3 { background: #6fcf5a; --dx: -170rpx; --dy: -110rpx; animation-delay: 0.1s; }

.b4 { background: #3577c0; --dx: 160rpx; --dy: -140rpx; animation-delay: 0.08s; }

.b5 { background: #ff8ab8; --dx: -40rpx; --dy: -260rpx; animation-delay: 0.12s; }

.b6 { background: #ffd34d; --dx: 50rpx; --dy: -90rpx; animation-delay: 0.15s; }

/* 摆放时的两个按钮 */
.placing-btns {
  display: flex;
  gap: 12rpx;
}

.placing-btns .btn-small {
  width: auto !important;
  margin: 0;
  padding: 8rpx 20rpx;
  white-space: nowrap;
}

.side-emoji {
  font-size: 56rpx;
  line-height: 1.1;
}

/* 住户列表（在抽屉 components/sheet 里，多了在抽屉里滚） */
.res-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 8rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}

.res-avatar {
  width: 88rpx;
  height: 88rpx;
}

.res-body {
  flex: 1;
}

.res-name {
  font-size: 32rpx;
  font-weight: 700;
}

.res-text {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.res-go {
  font-size: 28rpx;
  color: var(--primary);
}

/* ---- 营地专用 ---- */
.backdrop { position: absolute; left: 0; top: 0; display: block; }
.base { position: absolute; display: block; }
/* 上下补的天空、草地：草地第一行盖住营地画最下面发虚的那段，要压得住画上的「熄火」补丁（z 2），又在所有站在地上的东西（z ≥ 99）下面 */
.frame-tile { z-index: 3; }
.cut { position: absolute; overflow: hidden; pointer-events: none; }
.cut-img { position: absolute; top: 0; display: block; max-width: none; }
.decor { position: absolute; display: block; }
.ghosted { opacity: 0.6; }
/* 点锅的地方：透明，排在锅那层上面、锅前面的宠物下面 */
.pot-hit { position: absolute; }
.hud-note-gold { background: rgba(255, 244, 214, 0.95); color: #9a6b12; }
/* 背包抽屉（components/sheet）顶上的「食物 / 装饰」（components/segmented） */
.bag-tabs { width: 360rpx; }
.bag-hint { margin-top: 8rpx; }
/* 食物、装饰两页叠在同一格：一排两个 100% 宽、第二个往左挪回来，高度按高的那页，切换只淡入淡出、抽屉不跳 */
.bag-panes { display: flex; align-items: flex-start; }
.bag-pane { flex: 0 0 100%; min-width: 0; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
.bag-pane + .bag-pane { margin-left: -100%; }
.bag-pane-on { opacity: 1; pointer-events: auto; }

/* 宠物：单张图时按动作挂动画；走路 gait-on 时上下颠。
   走路用 transform 挪（贴在左下角 0,0 再平移）：left / bottom 过渡每一帧都要重新排版、重画底下放大了的整张画，手机上走起来一直闪；
   transform 交给显卡单独一层挪，初始的 transform 和 transition 都先写在这儿，开头不闪 */
.pet { position: absolute; left: 0; bottom: 0; transform: translate3d(0, 0, 0); transition-property: transform; transition-timing-function: linear; will-change: transform; -webkit-backface-visibility: hidden; backface-visibility: hidden; }
.pet-body { position: relative; width: 100%; }
.pet-body.flip { transform: scaleX(-1); }
.pet-img { display: block; width: 100%; transform-origin: 50% 100%; }
/* 夜里盖在本体上的月光版（同一张图去色染成夜色的蓝白，不透明度跟着站的地方变）：和本体同一套动画，叠得严丝合缝 */
.pet-img.moon { position: absolute; left: 0; top: 0; pointer-events: none; }
.anim-strip.moon { pointer-events: none; }
.decor-moon { pointer-events: none; }
.pet-img.gait-on { animation: trot 0.42s ease-in-out infinite; }
@keyframes trot { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-6%) rotate(2deg); } }
.act-idle { animation: breathe 2.4s ease-in-out infinite; }
@keyframes breathe { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(1.03); } }
.act-sleep { animation: snooze 3s ease-in-out infinite; }
@keyframes snooze { 0%, 100% { transform: scale(1, 0.92) translateY(4%); } 50% { transform: scale(1.03, 0.9) translateY(5%); } }
.act-eat { animation: chomp 0.5s ease-in-out infinite; }
@keyframes chomp { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(-8deg) translateY(3%); } }
.act-happy { animation: wiggle 0.5s ease-in-out infinite; }
@keyframes wiggle { 0%, 100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }
.act-roll { animation: roll 1.2s linear 1; }
@keyframes roll { 0% { transform: rotate(0); } 100% { transform: rotate(360deg); } }
.act-pet { animation: purr 0.3s ease-in-out infinite; }
@keyframes purr { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.04, 0.97); } }
.act-jump { animation: hop 0.6s ease-out infinite; }
@keyframes hop { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-30%); } }
.act-sit { transform: scaleY(0.9) translateY(5%); }
.act-soak { clip-path: inset(0 0 38% 0); -webkit-clip-path: inset(0 0 38% 0); transform: translateY(38%); animation: bob 2s ease-in-out infinite; }
@keyframes bob { 0%, 100% { transform: translateY(38%); } 50% { transform: translateY(41%); } }
.act-dislike { animation: shake 0.4s ease-in-out 3; }
@keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-6%); } 75% { transform: translateX(6%); } }

/* 拖拽：装饰的幽灵块 + 落脚框 */
.drag-foot { position: absolute; border-radius: 12rpx; border: 4rpx dashed rgba(255, 255, 255, 0.9); box-sizing: border-box; }
.drag-foot.ok { background: rgba(120, 220, 120, 0.35); }
.drag-foot.bad { background: rgba(230, 90, 70, 0.35); }

/* 一天的光 */
.tint { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1700; }
.tint-dusk { background: linear-gradient(180deg, rgba(255, 150, 60, 0.18), rgba(255, 120, 80, 0.26)); }
.tint-night { background: radial-gradient(circle at 50% 61%, rgba(255, 170, 60, 0) 0, rgba(255, 170, 60, 0) 9%, rgba(20, 30, 80, 0.45) 30%, rgba(14, 22, 70, 0.6) 100%); }

.fx-firefly { position: absolute; pointer-events: none; border-radius: 50%; background: radial-gradient(circle, #fff7a8 0%, rgba(255, 240, 120, 0.6) 40%, rgba(255, 240, 120, 0) 70%); animation: glimmer 4s ease-in-out infinite; }
@keyframes glimmer { 0%, 100% { opacity: 0; transform: translate(0, 0); } 30% { opacity: 1; } 60% { opacity: 0.3; transform: translate(640%, -820%); } 80% { opacity: 1; } }
.fx-glow { position: absolute; pointer-events: none; border-radius: 50%; background: radial-gradient(circle, rgba(255, 220, 120, 0.55) 0%, rgba(255, 200, 80, 0) 70%); animation: pulse 2.6s ease-in-out infinite; mix-blend-mode: screen; }
@keyframes pulse { 0%, 100% { opacity: 0.7; transform: scale(1); } 50% { opacity: 1; transform: scale(1.08); } }

/* 宠物头上的表情 */
.act-emoji {
  position: absolute;
  right: -10%;
  top: -10%;
  font-size: 40rpx;
  animation: float 1.6s ease-in-out infinite;
}

/* 锅是空的火不烧：盖在底图上的「熄了火」那块（从画上熄的，和底图像素对齐） */
.fx-patch { position: absolute; display: block; pointer-events: none; }

/* 篝火：从画上取的逐帧火苗，横着拼成一条，steps(8) 一帧一帧跳（帧数和 scene-fx.js 的 FIRE_FRAMES 一致） */
.fx-fire { position: absolute; overflow: hidden; pointer-events: none; }
.fx-fire-strip { position: absolute; display: block; max-width: none; animation: fire-strip 960ms steps(8) infinite; }
@keyframes fire-strip { to { transform: translateX(-100%); } }

/* 火光：一圈暖光盖在锅底、石头和草上，不规则地一跳一跳 */
.fx-fireglow { position: absolute; pointer-events: none; border-radius: 50%; background: radial-gradient(ellipse at 50% 50%, rgba(255, 190, 90, 0.34) 0%, rgba(255, 165, 70, 0.14) 40%, rgba(255, 150, 60, 0) 70%); mix-blend-mode: screen; animation: fire-glow 2.3s linear infinite; }
.fx-fireglow-night { background: radial-gradient(ellipse at 50% 50%, rgba(255, 185, 90, 0.5) 0%, rgba(255, 150, 60, 0.22) 35%, rgba(255, 140, 50, 0) 70%); }
@keyframes fire-glow {
  0% { opacity: 0.86; transform: scale(1); }
  9% { opacity: 1; transform: scale(1.03); }
  17% { opacity: 0.78; transform: scale(0.99); }
  31% { opacity: 0.95; transform: scale(1.01); }
  44% { opacity: 0.8; transform: scale(0.98); }
  58% { opacity: 1; transform: scale(1.04); }
  70% { opacity: 0.84; transform: scale(1); }
  83% { opacity: 0.96; transform: scale(1.02); }
  100% { opacity: 0.86; transform: scale(1); }
}

/* 火星：很小的亮点从火口往上飘、慢慢灭（三种飘法错开） */
.fx-ember { position: absolute; pointer-events: none; border-radius: 50%; background: radial-gradient(circle, #fff6c8 0%, #ffc45a 38%, rgba(255, 140, 40, 0) 72%); opacity: 0; animation: ember-a 2.6s ease-out infinite; }
.fx-ember-b { animation-name: ember-b; animation-duration: 3.1s; }
.fx-ember-c { animation-name: ember-c; animation-duration: 2.2s; }
@keyframes ember-a { 0% { opacity: 0; transform: translate(0, 0) scale(1); } 12% { opacity: 1; } 55% { opacity: 0.85; transform: translate(130%, -900%) scale(0.85); } 100% { opacity: 0; transform: translate(-50%, -1700%) scale(0.4); } }
@keyframes ember-b { 0% { opacity: 0; transform: translate(0, 0) scale(1); } 15% { opacity: 1; } 50% { opacity: 0.8; transform: translate(-150%, -800%) scale(0.8); } 100% { opacity: 0; transform: translate(80%, -1500%) scale(0.35); } }
@keyframes ember-c { 0% { opacity: 0; transform: translate(0, 0) scale(1); } 10% { opacity: 1; } 60% { opacity: 0.9; transform: translate(40%, -1100%) scale(0.75); } 100% { opacity: 0; transform: translate(160%, -1900%) scale(0.4); } }

/* 热气：一缕很淡的白烟从锅口 / 壶嘴飘起来，散开、消失 */
.fx-wisp { position: absolute; pointer-events: none; opacity: 0; transform-origin: 50% 100%; animation: wisp 3.6s ease-out infinite; }
@keyframes wisp {
  0% { opacity: 0; transform: translateY(12%) scale(0.6, 0.5); }
  20% { opacity: 0.6; }
  60% { opacity: 0.38; transform: translateY(-22%) scale(1, 1) skewX(-4deg); }
  100% { opacity: 0; transform: translateY(-55%) scale(1.25, 1.2) skewX(4deg); }
}
