<view wx:if="{{!loaded}}" class="empty">扭蛋机准备中…</view>

<view class="page" wx:if="{{loaded}}">
  <view class="beans">
    <image class="beans-icon" src="/images/garden/ui/bean.png" mode="aspectFit" />
    <text class="beans-num">{{beans}}</text>
    <text class="beans-unit">暖豆</text>
  </view>

  <view wx:if="{{termText}}" class="term">🍂 {{termText}}</view>

  <view class="machine-wrap">
    <image class="machine {{phase === 'shaking' ? 'machine-shake' : ''}}" src="/images/garden/ui/gacha.png" mode="aspectFit" />
  </view>

  <button class="btn-primary btn-big" bindtap="spin" disabled="{{phase === 'shaking' || phase === 'capsule'}}">
    {{phase === 'shaking' ? '咕噜咕噜…' : '扭一个（' + spinCost + ' 暖豆）'}}
  </button>

  <view class="card info">
    <view class="info-line">🎯 再扭 <text class="strong">{{pityLeft}}</text> 次，必出珍稀以上</view>
    <view class="info-line muted small">出货概率：{{ratesText}}</view>
    <view class="info-line muted small">暖豆只能靠打卡赚：每天早午晚三顿都打卡，暖豆最多</view>
  </view>

  <view wx:if="{{phase === 'capsule' || phase === 'reveal'}}" class="overlay">
    <view wx:if="{{phase === 'capsule'}}" class="capsule-box" bindtap="openCapsule">
      <image class="capsule" src="{{result.capsule}}" mode="aspectFit" />
      <view class="capsule-tip">点一下，打开扭蛋</view>
    </view>

    <view wx:else class="reveal">
      <view class="rays" style="background: radial-gradient(circle, {{result.rarityColor}}55 0%, {{result.rarityColor}}00 70%)"></view>
      <view wx:if="{{result.isNew}}" class="new-badge">新！</view>
      <image class="reveal-image" src="{{result.image}}" mode="aspectFit" />
      <view class="reveal-name">{{result.name}}</view>
      <view class="rarity-pill" style="background: {{result.rarityColor}}">{{result.rarityLabel}}</view>
      <view class="reveal-actions">
        <button class="btn-plain reveal-btn" bindtap="goCamp">去喂它们</button>
        <button class="btn-primary reveal-btn" bindtap="spin" disabled="{{beans < spinCost}}">再扭一次</button>
      </view>
      <view class="link link-muted" bindtap="closeResult">收进背包</view>
    </view>
  </view>
</view>
