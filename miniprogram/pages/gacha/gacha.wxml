<view wx:if="{{!loaded}}" class="empty">扭蛋机准备中…</view>

<view class="page" wx:if="{{loaded}}">
  <view class="beans">
    <image class="beans-icon" src="/images/garden/ui/bean.png" mode="aspectFit" />
    <text class="beans-num">{{beans}}</text>
    <text class="beans-unit">暖豆</text>
  </view>

  <view wx:if="{{termText}}" class="term">🍂 {{termText}}</view>

  <view class="machine-wrap">
    <image class="machine {{phase === 'shaking' ? 'machine-shake' : ''}}" src="/images/garden/ui/gacha.png" mode="aspectFit" />
  </view>

  <!-- 单抽、十连并排（抽卡游戏的样子）：上面扭几次，下面暖豆和价钱；十连黑底高亮、角上一条「必出珍稀」 -->
  <view class="pull-row {{phase === 'shaking' || phase === 'capsule' ? 'pull-busy' : ''}}">
    <view class="pull pull-one" hover-class="pull-press" bindtap="spin">
      <view class="pull-title">扭 <text class="pull-n num">1</text> 次</view>
      <view class="pull-cost {{beans < spinCost ? 'pull-poor' : ''}}">
        <image class="pull-bean" src="/images/garden/ui/bean.png" mode="aspectFit" />
        <text class="num">{{spinCost}}</text>
      </view>
    </view>
    <view class="pull pull-ten" hover-class="pull-press" bindtap="spinMany">
      <view wx:if="{{tenSure}}" class="pull-ribbon">必出珍稀</view>
      <view class="pull-title">扭 <text class="pull-n num">{{spinMany}}</text> 次</view>
      <view class="pull-cost {{beans < spinManyCost ? 'pull-poor' : ''}}">
        <image class="pull-bean" src="/images/garden/ui/bean.png" mode="aspectFit" />
        <text class="num">{{spinManyCost}}</text>
      </view>
    </view>
  </view>
  <view class="pull-hint">{{phase === 'shaking' ? '咕噜咕噜…' : ''}}</view>

  <view class="card info">
    <view class="info-line">🎯 再扭 <text class="strong">{{pityLeft}}</text> 次，必出珍稀以上</view>
    <view class="info-line muted small">出货概率：{{ratesText}}</view>
    <view class="info-line muted small">暖豆只能靠打卡赚：每天早午晚三顿都打卡，暖豆最多</view>
  </view>

  <view wx:if="{{phase === 'capsule' || phase === 'reveal' || phase === 'many'}}" class="overlay">
    <view wx:if="{{phase === 'capsule'}}" class="capsule-box" bindtap="openCapsule">
      <image class="capsule" src="{{result.capsule}}" mode="aspectFit" />
      <view class="capsule-tip">点一下，打开扭蛋</view>
    </view>

    <!-- 十连：十个一起开，一个一个蹦出来 -->
    <view wx:elif="{{phase === 'many'}}" class="reveal reveal-many">
      <view class="many-title">{{spinMany}} 个都开出来啦</view>
      <view class="many-grid">
        <view wx:for="{{results}}" wx:key="index" class="many-cell fx-pop" style="animation-delay: {{index * 90}}ms; border-color: {{item.rarityColor}}">
          <view wx:if="{{item.isNew}}" class="many-new">新</view>
          <image class="many-image" src="{{item.image}}" mode="aspectFit" />
          <view class="many-name">{{item.name}}</view>
          <view class="many-rarity" style="color: {{item.rarityColor}}">{{item.rarityLabel}}</view>
        </view>
      </view>
      <view class="many-sum">{{manyText}}</view>
      <view class="reveal-actions">
        <button class="btn-plain reveal-btn" bindtap="goCamp">去喂它们</button>
        <button class="btn-primary reveal-btn" bindtap="spinMany" disabled="{{beans < spinManyCost}}">再来十连</button>
      </view>
      <view class="link link-muted" bindtap="closeResult">收进背包</view>
    </view>

    <view wx:else class="reveal">
      <view class="rays" style="background: radial-gradient(circle, {{result.rarityColor}}55 0%, {{result.rarityColor}}00 70%)"></view>
      <view wx:if="{{result.isNew}}" class="new-badge">新！</view>
      <image class="reveal-image" src="{{result.image}}" mode="aspectFit" />
      <view class="reveal-name">{{result.name}}</view>
      <view class="rarity-pill" style="background: {{result.rarityColor}}">{{result.rarityLabel}}</view>
      <view class="reveal-actions">
        <button class="btn-plain reveal-btn" bindtap="goCamp">去喂它们</button>
        <button class="btn-primary reveal-btn" bindtap="spin" disabled="{{beans < spinCost}}">再扭一次</button>
      </view>
      <view class="link link-muted" bindtap="closeResult">收进背包</view>
    </view>
  </view>
</view>
