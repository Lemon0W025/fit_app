.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 8rpx 16rpx;
}

.beans {
  display: flex;
  align-items: center;
  background: #fff4e0;
  border-radius: 40rpx;
  padding: 8rpx 24rpx 8rpx 12rpx;
}

.beans-icon {
  width: 56rpx;
  height: 56rpx;
}

.beans-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #d97a1e;
  margin-left: 8rpx;
}

.beans-unit {
  font-size: 26rpx;
  color: #b8763a;
  margin-left: 6rpx;
}

.collect {
  font-size: 28rpx;
  color: var(--primary);
  padding: 12rpx 0 12rpx 16rpx;
}

.term {
  font-size: 26rpx;
  color: #b8763a;
  background: #fff4e0;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.garden {
  position: relative;
  width: 100%;
  overflow: visible;
}

.land {
  position: absolute;
  left: 0;
  z-index: 0;
}

.hint {
  position: absolute;
  z-index: 5;
  animation: hint-pulse 1.2s ease-in-out infinite;
}

@keyframes hint-pulse {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

.sprite {
  position: absolute;
  filter: drop-shadow(0 6rpx 4rpx rgba(60, 50, 30, 0.25));
}

.sprite-ghost {
  pointer-events: none;
  opacity: 0.85;
}

.placing {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fffbe8;
  margin-top: 16rpx;
}

.placing-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #8a6a1e;
}

button.btn-small {
  width: 140rpx !important;
  margin: 0 0 0 16rpx;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 0;
}

.action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  padding: 16rpx 0 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(80, 60, 30, 0.05);
}

.action-main {
  background: linear-gradient(180deg, #fff1e6 0%, #ffffff 100%);
  color: #c0442f;
}

.action-icon {
  width: 110rpx;
  height: 110rpx;
  margin-bottom: 4rpx;
}

.bag {
  white-space: nowrap;
}

.bag-item {
  display: inline-block;
  position: relative;
  width: 150rpx;
  margin-right: 16rpx;
  padding: 12rpx 0 10rpx;
  text-align: center;
  border: 3rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--gray-soft);
  vertical-align: top;
}

.bag-image {
  width: 110rpx;
  height: 110rpx;
}

.bag-name {
  font-size: 24rpx;
  white-space: normal;
  line-height: 1.3;
  padding: 0 6rpx;
}

.bag-count {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #d97a1e;
}

.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(47, 42, 36, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.welcome {
  width: 78%;
  background: var(--card);
  border-radius: 32rpx;
  padding: 40rpx 40rpx 24rpx;
  text-align: center;
}

.welcome-gift {
  width: 220rpx;
  height: 220rpx;
  animation: gift-pop 0.6s ease-out;
}

@keyframes gift-pop {
  0% {
    transform: scale(0.3) rotate(-12deg);
  }
  70% {
    transform: scale(1.1) rotate(4deg);
  }
  100% {
    transform: scale(1) rotate(0);
  }
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--primary);
  margin: 12rpx 0;
}

.welcome-text {
  font-size: 30rpx;
  text-align: left;
  line-height: 1.7;
}

.welcome-later {
  display: block;
  margin-top: 4rpx;
}
