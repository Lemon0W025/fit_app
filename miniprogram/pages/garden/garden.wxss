.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 8rpx 16rpx;
}

.beans {
  display: flex;
  align-items: center;
  background: #fff4e0;
  border-radius: 40rpx;
  padding: 8rpx 24rpx 8rpx 12rpx;
}

.beans-icon {
  width: 56rpx;
  height: 56rpx;
}

.beans-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #d97a1e;
  margin-left: 8rpx;
}

.beans-unit {
  font-size: 26rpx;
  color: #b8763a;
  margin-left: 6rpx;
}

.collect {
  font-size: 28rpx;
  color: var(--primary);
  padding: 12rpx 0 12rpx 16rpx;
}

.term {
  font-size: 26rpx;
  color: #b8763a;
  background: #fff4e0;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.garden {
  position: relative;
  width: 100%;
  overflow: visible;
}

.land {
  position: absolute;
  left: 0;
  z-index: 0;
}

.hint {
  position: absolute;
  z-index: 5;
  animation: hint-pulse 1.2s ease-in-out infinite;
}

@keyframes hint-pulse {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

.sprite {
  position: absolute;
  filter: drop-shadow(0 6rpx 4rpx rgba(60, 50, 30, 0.25));
}

.sprite-ghost {
  pointer-events: none;
  opacity: 0.85;
}

.placing {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fffbe8;
  margin-top: 16rpx;
}

.placing-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #8a6a1e;
}

button.btn-small {
  width: 140rpx !important;
  margin: 0 0 0 16rpx;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 0;
}

.action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  padding: 16rpx 0 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(80, 60, 30, 0.05);
}

.action-main {
  background: linear-gradient(180deg, #fff1e6 0%, #ffffff 100%);
  color: #c0442f;
}

.action-icon {
  width: 110rpx;
  height: 110rpx;
  margin-bottom: 4rpx;
}

.bag {
  white-space: nowrap;
}

.bag-item {
  display: inline-block;
  position: relative;
  width: 150rpx;
  margin-right: 16rpx;
  padding: 12rpx 0 10rpx;
  text-align: center;
  border: 3rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--gray-soft);
  vertical-align: top;
}

.bag-image {
  width: 110rpx;
  height: 110rpx;
}

.bag-name {
  font-size: 24rpx;
  white-space: normal;
  line-height: 1.3;
  padding: 0 6rpx;
}

.bag-count {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #d97a1e;
}

.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(47, 42, 36, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.welcome {
  width: 78%;
  background: var(--card);
  border-radius: 32rpx;
  padding: 40rpx 40rpx 24rpx;
  text-align: center;
}

.welcome-gift {
  width: 220rpx;
  height: 220rpx;
  animation: gift-pop 0.6s ease-out;
}

@keyframes gift-pop {
  0% {
    transform: scale(0.3) rotate(-12deg);
  }
  70% {
    transform: scale(1.1) rotate(4deg);
  }
  100% {
    transform: scale(1) rotate(0);
  }
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--primary);
  margin: 12rpx 0;
}

.welcome-text {
  font-size: 30rpx;
  text-align: left;
  line-height: 1.7;
}

.welcome-later {
  display: block;
  margin-top: 4rpx;
}

.waiting {
  font-size: 26rpx;
  color: var(--primary);
  background: #eef6ea;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

/* ---------------------------------------------------------------- 小动物 */

.animal {
  position: absolute;
  transition-property: left, bottom;
  transition-timing-function: linear;
}

.animal-ghost {
  opacity: 0.35;
  pointer-events: none;
}

.animal-body {
  position: relative;
}

/* 镜像放在外层，里面的图片还能做自己的动画 */
.flip {
  transform: scaleX(-1);
}

/* 下水：只露出上半身 */
.in-water {
  overflow: hidden;
}

.animal-img {
  display: block;
  width: 100%;
  transform-origin: 50% 100%;
  filter: drop-shadow(0 4rpx 3rpx rgba(60, 50, 30, 0.25));
}

.act-walk {
  animation: hop 0.4s ease-in-out infinite;
}

.act-idle,
.act-bask,
.act-warm {
  animation: breathe 2.4s ease-in-out infinite;
}

.act-sleep,
.act-perch {
  animation: breathe 3.6s ease-in-out infinite;
}

.act-eat {
  animation: chomp 0.5s ease-in-out infinite;
}

.act-peck {
  animation: peck 0.3s ease-in-out infinite;
}

.act-swim {
  animation: bob 1.6s ease-in-out infinite;
}

.act-swing {
  transform-origin: 50% -40%;
  animation: swing 1.8s ease-in-out infinite;
}

/* 小黄鸭在池子里来回划水 */
.paddle {
  animation: paddle 4s ease-in-out infinite;
}

@keyframes paddle {
  0%,
  100% {
    transform: translateX(-18%) translateY(0);
  }
  50% {
    transform: translateX(18%) translateY(4%);
  }
}

/* 放在各种动作后面：点一下的跳跃优先 */
.tap {
  animation: jump 0.6s ease-out;
}

@keyframes hop {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12%);
  }
}

@keyframes breathe {
  0%,
  100% {
    transform: scale(1, 1);
  }
  50% {
    transform: scale(1.02, 0.97);
  }
}

@keyframes chomp {
  0%,
  100% {
    transform: rotate(0) translateY(0);
  }
  50% {
    transform: rotate(-6deg) translateY(4%);
  }
}

@keyframes peck {
  0%,
  100% {
    transform: rotate(0);
  }
  50% {
    transform: rotate(18deg) translateY(6%);
  }
}

@keyframes bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(5%);
  }
}

@keyframes swing {
  0%,
  100% {
    transform: rotate(-14deg);
  }
  50% {
    transform: rotate(14deg);
  }
}

@keyframes jump {
  0%,
  100% {
    transform: translateY(0) scale(1, 1);
  }
  30% {
    transform: translateY(-30%) scale(1.05, 0.95);
  }
  60% {
    transform: translateY(0) scale(1.08, 0.92);
  }
}

.ripple {
  position: absolute;
  left: 10%;
  bottom: -8%;
  width: 80%;
  height: 24%;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  animation: ripple 1.8s ease-out infinite;
}

@keyframes ripple {
  0% {
    transform: scale(0.5);
    opacity: 1;
  }
  100% {
    transform: scale(1.4);
    opacity: 0;
  }
}

.bubble {
  position: absolute;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #4a3f35;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 30, 0.18);
  z-index: 2;
}

.act-emoji {
  position: absolute;
  right: -10%;
  top: -10%;
  font-size: 30rpx;
  animation: float 1.6s ease-in-out infinite;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.heart {
  position: absolute;
  left: 50%;
  top: -20%;
  font-size: 32rpx;
  animation: rise 0.9s ease-out forwards;
}

@keyframes rise {
  0% {
    transform: translate(-50%, 0) scale(0.6);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -60rpx) scale(1.2);
    opacity: 0;
  }
}
