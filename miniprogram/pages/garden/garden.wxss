/* ---------------------------------------------------------------- 全屏地图 */

page {
  height: 100%;
  overflow: hidden;
}

.screen {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #cfe6c4 0%, #e3efd6 45%, #f6f1e7 100%);
}

.loading {
  padding-top: 40vh;
  text-align: center;
  color: var(--muted);
}

.map-area {
  width: 100%;
  height: 100%;
}

.world {
  position: absolute;
}

.plot {
  position: absolute;
}

.plot-new {
  animation: plot-in 1s ease-out;
}

@keyframes plot-in {
  0% {
    opacity: 0.2;
  }
  100% {
    opacity: 1;
  }
}

.decor {
  position: absolute;
  pointer-events: none;
}

.decor-cloud {
  opacity: 0.9;
  animation: drift 24s ease-in-out infinite alternate;
}

@keyframes drift {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(40%);
  }
}

/* 开荒时冒的一团尘土 */
.dust {
  position: absolute;
  z-index: 9;
  pointer-events: none;
}

.puff {
  position: absolute;
  width: 28%;
  height: 40%;
  border-radius: 50%;
  background: rgba(214, 190, 150, 0.85);
  opacity: 0;
  animation: puff 1.2s ease-out forwards;
}

.puff-1 {
  left: 20%;
  top: 30%;
}

.puff-2 {
  left: 50%;
  top: 20%;
  animation-delay: 0.1s;
}

.puff-3 {
  left: 35%;
  top: 50%;
  animation-delay: 0.2s;
}

.puff-4 {
  left: 60%;
  top: 45%;
  animation-delay: 0.15s;
}

@keyframes puff {
  0% {
    opacity: 0.9;
    transform: scale(0.4);
  }
  100% {
    opacity: 0;
    transform: scale(1.6) translateY(-30%);
  }
}

/* 开荒木牌 */
.sign {
  position: absolute;
  z-index: 8;
  transform-origin: 50% 100%;
  animation: sway 2.6s ease-in-out infinite;
}

@keyframes sway {
  0%,
  100% {
    transform: rotate(-3deg);
  }
  50% {
    transform: rotate(3deg);
  }
}

.sign-img {
  display: block;
  width: 100%;
}

.sign-text {
  position: absolute;
  left: 0;
  right: 0;
  top: 14%;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #5a3a1a;
}

.sign-cost {
  display: block;
  font-size: 24rpx;
  color: #b8461e;
}

/* ---------------------------------------------------------------- 浮在地图上的按钮 */

.hud-beans {
  position: absolute;
  left: 24rpx;
  z-index: 50;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 40rpx;
  padding: 0 24rpx 0 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 30, 0.12);
}

.hud-collect {
  position: absolute;
  right: 24rpx;
  z-index: 50;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 30, 0.12);
}

.hud-notes {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  z-index: 50;
  pointer-events: none;
}

.note {
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  color: #b8763a;
  background: rgba(255, 244, 224, 0.95);
  border-radius: 16rpx;
}

.note-green {
  color: var(--primary);
  background: rgba(238, 246, 234, 0.95);
}

.recenter {
  position: absolute;
  right: 24rpx;
  bottom: 220rpx;
  z-index: 50;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 30, 0.15);
}

.recenter-icon {
  width: 56rpx;
  height: 56rpx;
}

.dock {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 28rpx;
  z-index: 50;
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.dock-btn {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(60, 50, 30, 0.16);
}

.dock-main {
  background: linear-gradient(180deg, #fff1e6 0%, #ffffff 100%);
  color: #c0442f;
}

.dock-icon {
  width: 88rpx;
  height: 88rpx;
}

.badge {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #e8553b;
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
}

.placing {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  z-index: 55;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fffbe8;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(60, 50, 30, 0.16);
}

/* 背包抽屉 */
.drawer-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(47, 42, 36, 0.35);
}

.drawer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 61;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx 40rpx;
  transform: translateY(110%);
  transition: transform 0.25s ease-out;
}

.drawer-open {
  transform: translateY(0);
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
}

.drawer-close {
  font-size: 36rpx;
  color: var(--gray);
  padding: 0 8rpx;
}

.beans-icon {
  width: 56rpx;
  height: 56rpx;
}

.beans-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #d97a1e;
  margin-left: 8rpx;
}

.beans-unit {
  font-size: 26rpx;
  color: #b8763a;
  margin-left: 6rpx;
}

.hint {
  position: absolute;
  z-index: 5;
  animation: hint-pulse 1.2s ease-in-out infinite;
}

@keyframes hint-pulse {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

.sprite {
  position: absolute;
  filter: drop-shadow(0 6rpx 4rpx rgba(60, 50, 30, 0.25));
}

.sprite-ghost {
  pointer-events: none;
  opacity: 0.85;
}

.placing-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #8a6a1e;
}

button.btn-small {
  width: 140rpx !important;
  margin: 0 0 0 16rpx;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.bag {
  white-space: nowrap;
}

.bag-item {
  display: inline-block;
  position: relative;
  width: 150rpx;
  margin-right: 16rpx;
  padding: 12rpx 0 10rpx;
  text-align: center;
  border: 3rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--gray-soft);
  vertical-align: top;
}

.bag-image {
  width: 110rpx;
  height: 110rpx;
}

.bag-name {
  font-size: 24rpx;
  white-space: normal;
  line-height: 1.3;
  padding: 0 6rpx;
}

.bag-count {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #d97a1e;
}

.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(47, 42, 36, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.welcome {
  width: 78%;
  background: var(--card);
  border-radius: 32rpx;
  padding: 40rpx 40rpx 24rpx;
  text-align: center;
}

.welcome-gift {
  width: 220rpx;
  height: 220rpx;
  animation: gift-pop 0.6s ease-out;
}

@keyframes gift-pop {
  0% {
    transform: scale(0.3) rotate(-12deg);
  }
  70% {
    transform: scale(1.1) rotate(4deg);
  }
  100% {
    transform: scale(1) rotate(0);
  }
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--primary);
  margin: 12rpx 0;
}

.welcome-text {
  font-size: 30rpx;
  text-align: left;
  line-height: 1.7;
}

.welcome-later {
  display: block;
  margin-top: 4rpx;
}

/* ---------------------------------------------------------------- 小动物 */

.animal {
  position: absolute;
  transition-property: left, bottom;
  transition-timing-function: linear;
}

.animal-ghost {
  opacity: 0.35;
  pointer-events: none;
}

.animal-body {
  position: relative;
}

/* 镜像放在外层，里面的图片还能做自己的动画 */
.flip {
  transform: scaleX(-1);
}

/* 下水：只露出上半身 */
.in-water {
  overflow: hidden;
}

.animal-img {
  display: block;
  width: 100%;
  transform-origin: 50% 100%;
  filter: drop-shadow(0 4rpx 3rpx rgba(60, 50, 30, 0.25));
}

.act-walk {
  animation: hop 0.4s ease-in-out infinite;
}

.act-idle,
.act-bask,
.act-warm {
  animation: breathe 2.4s ease-in-out infinite;
}

.act-sleep,
.act-perch {
  animation: breathe 3.6s ease-in-out infinite;
}

.act-eat {
  animation: chomp 0.5s ease-in-out infinite;
}

.act-peck {
  animation: peck 0.3s ease-in-out infinite;
}

.act-swim {
  animation: bob 1.6s ease-in-out infinite;
}

.act-swing {
  transform-origin: 50% -40%;
  animation: swing 1.8s ease-in-out infinite;
}

/* 小黄鸭在池子里来回划水 */
.paddle {
  animation: paddle 4s ease-in-out infinite;
}

@keyframes paddle {
  0%,
  100% {
    transform: translateX(-18%) translateY(0);
  }
  50% {
    transform: translateX(18%) translateY(4%);
  }
}

/* 放在各种动作后面：点一下的跳跃优先 */
.tap {
  animation: jump 0.6s ease-out;
}

@keyframes hop {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12%);
  }
}

@keyframes breathe {
  0%,
  100% {
    transform: scale(1, 1);
  }
  50% {
    transform: scale(1.02, 0.97);
  }
}

@keyframes chomp {
  0%,
  100% {
    transform: rotate(0) translateY(0);
  }
  50% {
    transform: rotate(-6deg) translateY(4%);
  }
}

@keyframes peck {
  0%,
  100% {
    transform: rotate(0);
  }
  50% {
    transform: rotate(18deg) translateY(6%);
  }
}

@keyframes bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(5%);
  }
}

@keyframes swing {
  0%,
  100% {
    transform: rotate(-14deg);
  }
  50% {
    transform: rotate(14deg);
  }
}

@keyframes jump {
  0%,
  100% {
    transform: translateY(0) scale(1, 1);
  }
  30% {
    transform: translateY(-30%) scale(1.05, 0.95);
  }
  60% {
    transform: translateY(0) scale(1.08, 0.92);
  }
}

.ripple {
  position: absolute;
  left: 10%;
  bottom: -8%;
  width: 80%;
  height: 24%;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  animation: ripple 1.8s ease-out infinite;
}

@keyframes ripple {
  0% {
    transform: scale(0.5);
    opacity: 1;
  }
  100% {
    transform: scale(1.4);
    opacity: 0;
  }
}

.bubble {
  position: absolute;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #4a3f35;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 30, 0.18);
  z-index: 2;
}

.act-emoji {
  position: absolute;
  right: -10%;
  top: -10%;
  font-size: 30rpx;
  animation: float 1.6s ease-in-out infinite;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.heart {
  position: absolute;
  left: 50%;
  top: -20%;
  font-size: 32rpx;
  animation: rise 0.9s ease-out forwards;
}

@keyframes rise {
  0% {
    transform: translate(-50%, 0) scale(0.6);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -60rpx) scale(1.2);
    opacity: 0;
  }
}
