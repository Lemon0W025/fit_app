/* ---------------------------------------------------------------- 全屏地图 */

page {
  height: 100%;
  overflow: hidden;
}

.screen {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #e8e0cf;
}

.loading {
  padding-top: 40vh;
  text-align: center;
  color: var(--muted);
}

.map-area {
  width: 100%;
  height: 100%;
}

.world {
  position: absolute;
}

/* 修整角落的木牌 */
.sign {
  position: absolute;
  /* 木牌、云朵、彩带都压在物件、小动物和遮挡块（z 几百）上面 */
  z-index: 2100;
  transform-origin: 50% 100%;
  animation: sway 2.6s ease-in-out infinite;
}

@keyframes sway {
  0%,
  100% {
    transform: rotate(-3deg);
  }
  50% {
    transform: rotate(3deg);
  }
}

.sign-img {
  display: block;
  width: 100%;
}

.sign-text {
  position: absolute;
  left: 6%;
  right: 6%;
  top: 29%;
  height: 31%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-weight: 700;
  line-height: 1.1;
  color: #4a2e14;
  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
}

.sign-cost {
  position: absolute;
  left: 18%;
  right: 18%;
  top: 64%;
  padding: 2% 0;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.92);
  text-align: center;
  font-weight: 700;
  line-height: 1.2;
  color: #b8461e;
}

/* ---------------------------------------------------------------- 浮在地图上的按钮 */

.hud-collect {
  position: absolute;
  right: 24rpx;
  z-index: 50;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 30, 0.12);
}

.hud-notes {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  z-index: 50;
  pointer-events: none;
}

.hud-note {
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  color: #b8763a;
  background: rgba(255, 244, 224, 0.95);
  border-radius: 16rpx;
}

.hud-note-green {
  color: var(--primary);
  background: rgba(238, 246, 234, 0.95);
}

.recenter {
  position: absolute;
  left: 24rpx;
  bottom: 52rpx;
  z-index: 50;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 30, 0.15);
}

.recenter-icon {
  width: 56rpx;
  height: 56rpx;
}

.badge {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #e8553b;
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
}

.placing {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  z-index: 55;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fffbe8;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(60, 50, 30, 0.16);
}

/* 背包抽屉 */
.drawer-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(47, 42, 36, 0.35);
}

.drawer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 61;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx 40rpx;
  transform: translateY(110%);
  transition: transform 0.25s ease-out;
}

.drawer-open {
  transform: translateY(0);
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
}

.drawer-close {
  font-size: 36rpx;
  color: var(--gray);
  padding: 0 8rpx;
}

.hint {
  position: absolute;
  z-index: 5;
  animation: hint-pulse 1.2s ease-in-out infinite;
}

@keyframes hint-pulse {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

.sprite {
  position: absolute;
  filter: drop-shadow(0 6rpx 4rpx rgba(60, 50, 30, 0.25));
}

.sprite-ghost {
  pointer-events: none;
  opacity: 0.85;
}

.placing-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #8a6a1e;
}

button.btn-small {
  width: 140rpx !important;
  margin: 0 0 0 16rpx;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.bag {
  white-space: nowrap;
}

.bag-item {
  display: inline-block;
  position: relative;
  width: 150rpx;
  margin-right: 16rpx;
  padding: 12rpx 0 10rpx;
  text-align: center;
  border: 3rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--gray-soft);
  vertical-align: top;
}

.bag-image {
  width: 110rpx;
  height: 110rpx;
}

.bag-name {
  font-size: 24rpx;
  white-space: normal;
  line-height: 1.3;
  padding: 0 6rpx;
}

.bag-count {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #d97a1e;
}

.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(47, 42, 36, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.welcome {
  width: 78%;
  background: var(--card);
  border-radius: 32rpx;
  padding: 40rpx 40rpx 24rpx;
  text-align: center;
}

.welcome-gift {
  width: 220rpx;
  height: 220rpx;
  animation: gift-pop 0.6s ease-out;
}

@keyframes gift-pop {
  0% {
    transform: scale(0.3) rotate(-12deg);
  }
  70% {
    transform: scale(1.1) rotate(4deg);
  }
  100% {
    transform: scale(1) rotate(0);
  }
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--primary);
  margin: 12rpx 0;
}

.welcome-text {
  font-size: 30rpx;
  text-align: left;
  line-height: 1.7;
}

.welcome-later {
  display: block;
  margin-top: 4rpx;
}

/* ---------------------------------------------------------------- 小动物 */

.animal {
  position: absolute;
  transition-property: left, bottom;
  transition-timing-function: linear;
}

.animal-ghost {
  opacity: 0.35;
  pointer-events: none;
}

.animal-body {
  position: relative;
}

/* 镜像放在外层，里面的图片还能做自己的动画 */
.flip {
  transform: scaleX(-1);
}

/* 下水：只露出上半身 */
.in-water {
  overflow: hidden;
}

.animal-img {
  display: block;
  width: 100%;
  transform-origin: 50% 100%;
  filter: drop-shadow(0 4rpx 3rpx rgba(60, 50, 30, 0.25));
}

/* 逐帧动画：一张 6×4 的拼图，外框只露一格，里面的长条按帧数一格一格跳（steps），行、起始列用 margin 挪 */
.anim-frame {
  position: relative;
  overflow: hidden;
  transform-origin: 50% 100%;
  filter: drop-shadow(0 4rpx 3rpx rgba(60, 50, 30, 0.25));
}

.anim-strip {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  animation-iteration-count: infinite;
}

.anim-f6 {
  animation-name: strip6;
  animation-timing-function: steps(6);
}

.anim-f4 {
  animation-name: strip4;
  animation-timing-function: steps(4);
}

.anim-f2 {
  animation-name: strip2;
  animation-timing-function: steps(2);
}

@keyframes strip6 {
  to {
    transform: translateX(-100%);
  }
}

@keyframes strip4 {
  to {
    transform: translateX(-66.6667%);
  }
}

@keyframes strip2 {
  to {
    transform: translateX(-33.3333%);
  }
}

/* 走路的步态：四条腿的左右踱步，不蹦；鸭子小鸡摇摇摆摆；兔子蹦；乌龟慢慢爬；仙鹤迈大步 */
.gait-pad {
  animation: pad 0.56s ease-in-out infinite;
}

.gait-waddle {
  animation: waddle 0.36s ease-in-out infinite;
}

.gait-hop {
  animation: hop 0.45s ease-in-out infinite;
}

.gait-crawl {
  animation: crawl 1.4s ease-in-out infinite;
}

.gait-stride {
  animation: stride 0.9s ease-in-out infinite;
}

/* 会飞的：上下起伏地飞；蝴蝶扑棱翅膀 */
.gait-fly {
  animation: fly 0.8s ease-in-out infinite;
}

.gait-flutter {
  animation: flutter 0.24s ease-in-out infinite;
}

@keyframes pad {
  0%,
  100% {
    transform: rotate(-3deg) scale(1, 0.985);
  }
  50% {
    transform: rotate(3deg) scale(1, 1);
  }
}

@keyframes waddle {
  0%,
  100% {
    transform: rotate(-7deg);
  }
  50% {
    transform: rotate(7deg);
  }
}

@keyframes crawl {
  0%,
  100% {
    transform: scale(1, 1) rotate(-1.5deg);
  }
  50% {
    transform: scale(1.04, 0.97) rotate(1.5deg);
  }
}

@keyframes stride {
  0%,
  100% {
    transform: rotate(-2deg) translateY(0);
  }
  50% {
    transform: rotate(2deg) translateY(-2%);
  }
}

@keyframes fly {
  0%,
  100% {
    transform: translateY(0) rotate(-3deg);
  }
  50% {
    transform: translateY(-14%) rotate(3deg);
  }
}

@keyframes flutter {
  0%,
  100% {
    transform: scale(1, 1) translateY(0);
  }
  50% {
    transform: scale(0.55, 1.05) translateY(-6%);
  }
}

.act-idle,
.act-bask,
.act-warm {
  animation: breathe 2.4s ease-in-out infinite;
}

.act-sleep,
.act-perch {
  animation: breathe 3.6s ease-in-out infinite;
}

.act-eat {
  animation: chomp 0.5s ease-in-out infinite;
}

.act-peck {
  animation: peck 0.3s ease-in-out infinite;
}

.act-swim {
  animation: bob 1.6s ease-in-out infinite;
}

.act-swing {
  transform-origin: 50% -40%;
  animation: swing 1.8s ease-in-out infinite;
}

/* 小黄鸭在池子里来回划水 */
.paddle {
  animation: paddle 4s ease-in-out infinite;
}

@keyframes paddle {
  0%,
  100% {
    transform: translateX(-18%) translateY(0);
  }
  50% {
    transform: translateX(18%) translateY(4%);
  }
}

/* 放在各种动作后面：点一下的跳跃优先 */
.tap {
  animation: jump 0.6s ease-out;
}

@keyframes hop {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12%);
  }
}

@keyframes breathe {
  0%,
  100% {
    transform: scale(1, 1);
  }
  50% {
    transform: scale(1.02, 0.97);
  }
}

@keyframes chomp {
  0%,
  100% {
    transform: rotate(0) translateY(0);
  }
  50% {
    transform: rotate(-6deg) translateY(4%);
  }
}

@keyframes peck {
  0%,
  100% {
    transform: rotate(0);
  }
  50% {
    transform: rotate(18deg) translateY(6%);
  }
}

@keyframes bob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(5%);
  }
}

@keyframes swing {
  0%,
  100% {
    transform: rotate(-14deg);
  }
  50% {
    transform: rotate(14deg);
  }
}

@keyframes jump {
  0%,
  100% {
    transform: translateY(0) scale(1, 1);
  }
  30% {
    transform: translateY(-30%) scale(1.05, 0.95);
  }
  60% {
    transform: translateY(0) scale(1.08, 0.92);
  }
}

.ripple {
  position: absolute;
  left: 10%;
  bottom: -8%;
  width: 80%;
  height: 24%;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  animation: ripple 1.8s ease-out infinite;
}

@keyframes ripple {
  0% {
    transform: scale(0.5);
    opacity: 1;
  }
  100% {
    transform: scale(1.4);
    opacity: 0;
  }
}

.bubble {
  position: absolute;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #4a3f35;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(60, 50, 30, 0.18);
  z-index: 2;
}

.act-emoji {
  position: absolute;
  right: -10%;
  top: -10%;
  font-size: 30rpx;
  animation: float 1.6s ease-in-out infinite;
}

.act-fx {
  position: absolute;
  right: -18%;
  top: -22%;
  width: 44rpx;
  height: 44rpx;
  animation: float 1.6s ease-in-out infinite;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.heart {
  position: absolute;
  left: 50%;
  top: -20%;
  width: 44rpx;
  height: 44rpx;
  animation: rise 0.9s ease-out forwards;
}

@keyframes rise {
  0% {
    transform: translate(-50%, 0) scale(0.6);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -60rpx) scale(1.2);
    opacity: 0;
  }
}

/* ---------------------------------------------------------------- 小岛 */

/* 左上角：游戏风的暖豆资源条 + 今天的暖豆和印章 */
.hud-res {
  position: absolute;
  left: 24rpx;
  z-index: 50;
  display: flex;
  align-items: center;
  min-width: 200rpx;
  padding: 0 28rpx 0 6rpx;
  box-sizing: border-box;
  border: 4rpx solid #ffffff;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #3577c0 0%, #1d4f8a 100%);
  box-shadow: 0 6rpx 0 rgba(20, 50, 90, 0.35);
}

.res-icon {
  width: 60rpx;
  height: 60rpx;
}

.res-num {
  flex: 1;
  text-align: center;
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
}

.hud-today {
  position: absolute;
  left: 24rpx;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
}

.hud-today-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #b8763a;
}

.stamps-mini {
  gap: 4rpx;
  margin: 0;
}

.stamps-mini .stamp {
  width: 36rpx;
  height: 36rpx;
  font-size: 20rpx;
}

/* 左右两列圆按钮 */
.side {
  position: absolute;
  top: 36%;
  z-index: 50;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.side-left {
  left: 20rpx;
}

.side-right {
  right: 20rpx;
}

.side-btn {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  background: linear-gradient(180deg, #fff8ec 0%, #ffe9c7 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 0 rgba(150, 100, 40, 0.25);
}

.side-icon {
  width: 70rpx;
  height: 70rpx;
}

.side-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #8a4f1a;
  margin-top: -4rpx;
}

.dot {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #e8553b;
  border: 3rpx solid #ffffff;
}

/* 底部大打卡按钮 */
.checkin-btn {
  position: absolute;
  left: 50%;
  bottom: 36rpx;
  z-index: 50;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 26rpx 56rpx;
  border-radius: 60rpx;
  border: 5rpx solid #ffffff;
  background: linear-gradient(180deg, #6fcf5a 0%, #3e9a3a 100%);
  box-shadow: 0 8rpx 0 #2c6e2a;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  white-space: nowrap;
}

.checkin-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 10rpx;
}

/* ---------------------------------------------------------------- 宅院 */

.art {
  position: absolute;
  z-index: 1;
}

/* 物件、小动物脚下的影子 */
/* 遮挡块：从底图上抠下来的墙 / 门 / 建筑，盖在站在它后面的东西上；点击穿透 */
.occ {
  position: absolute;
  overflow: hidden;
  pointer-events: none;
}

.occ-img {
  position: absolute;
  display: block;
}

.shadow {
  position: absolute;
  border-radius: 50%;
  background: rgba(30, 40, 20, 0.18);
  pointer-events: none;
  transition-property: left, bottom;
  transition-timing-function: linear;
}

.sprite.flip {
  transform: scaleX(-1);
}

/* 没修的院子上的云，慢慢飘 */
.cloud {
  position: absolute;
  z-index: 2000;
  pointer-events: none;
  opacity: 0.96;
  animation: drift 7s ease-in-out infinite alternate;
}

@keyframes drift {
  0% {
    transform: translate(-4%, 0);
  }
  100% {
    transform: translate(4%, -3%);
  }
}

/* 修好院子时冒的一把彩带 */
.confetti {
  position: absolute;
  z-index: 2200;
  width: 0;
  height: 0;
  pointer-events: none;
}

.confetti-bit {
  position: absolute;
  width: 16rpx;
  height: 24rpx;
  border-radius: 4rpx;
  animation: toss 1.1s ease-out forwards;
}

.b1 { background: #f4b740; --dx: -120rpx; --dy: -200rpx; }
.b2 { background: #e8553b; --dx: 90rpx; --dy: -240rpx; animation-delay: 0.05s; }
.b3 { background: #6fcf5a; --dx: -170rpx; --dy: -110rpx; animation-delay: 0.1s; }
.b4 { background: #3577c0; --dx: 160rpx; --dy: -140rpx; animation-delay: 0.08s; }
.b5 { background: #ff8ab8; --dx: -40rpx; --dy: -260rpx; animation-delay: 0.12s; }
.b6 { background: #ffd34d; --dx: 50rpx; --dy: -90rpx; animation-delay: 0.15s; }

@keyframes toss {
  0% {
    transform: translate(0, 0) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translate(var(--dx), var(--dy)) rotate(540deg);
    opacity: 0;
  }
}

/* 做小事：轻轻扭一扭；泡在水里：上下浮 */
.act-trick {
  animation: wiggle 0.8s ease-in-out infinite;
}

@keyframes wiggle {
  0%,
  100% {
    transform: rotate(-6deg);
  }
  50% {
    transform: rotate(6deg);
  }
}

.act-soak {
  animation: bob 2s ease-in-out infinite;
}

/* 摆放时的两个按钮 */
.placing-btns {
  display: flex;
  gap: 12rpx;
}

.placing-btns .btn-small {
  width: auto !important;
  margin: 0;
  padding: 8rpx 20rpx;
  white-space: nowrap;
}

.side-emoji {
  font-size: 56rpx;
  line-height: 1.1;
}

/* 住户列表 */
.res-list {
  max-height: 50vh;
  overflow-y: auto;
}

.res-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 8rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}

.res-avatar {
  width: 88rpx;
  height: 88rpx;
}

.res-body {
  flex: 1;
}

.res-name {
  font-size: 32rpx;
  font-weight: 700;
}

.res-text {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.res-go {
  font-size: 28rpx;
  color: var(--primary);
}
